{
  "extends": "../../tsconfig.test.json",
  "include": ["src", "__tests__", "scripts"],
  "exclude": ["__tests__/e2e"],
  "compilerOptions": {
    "outDir": "build",
    "emitDeclarationOnly": true,
    // The benchmarks run on Node's native loader, which needs explicit extensions.
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals", "bun"],
    "paths": {
      "@/src/*": ["./src/*"]
    }
  }
}
