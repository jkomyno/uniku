#every-strategy","content":"`xid()`"},"182":{"id":"/docs/getting-started-57","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#every-strategy","content":"`string`"},"183":{"id":"/docs/getting-started-58","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#every-strategy","content":"TSID"},"184":{"id":"/docs/getting-started-59","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#every-strategy","content":"`uniku/tsid`"},"185":{"id":"/docs/getting-started-60","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#every-strategy","content":"`tsid()`"},"186":{"id":"/docs/getting-started-61","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#every-strategy","content":"`bigint`"},"187":{"id":"/docs/getting-started-62","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#every-strategy","content":"See Choosing an ID for the trade-offs, or open a generator reference when you already know which format you need."},"188":{"id":"/docs/getting-started-63","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#why-byte-helpers-exist","content":"UUIDs, ULIDs, TypeIDs, KSUIDs, ObjectIDs, XIDs, and TSIDs have a canonical binary representation. Their `toBytes()` and `fromBytes()` helpers let you store and transport that representation without inventing a second codec."},"189":{"id":"/docs/getting-started-64","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#why-byte-helpers-exist","content":"This matters when an ID lives in a binary database column, a compact protocol payload, or a cache key. A UUID, for instance, is 16 bytes instead of its 36-character string form. The helpers also make the string boundary explicit: convert when data leaves your application, preserve bytes where the system already handles bytes."},"190":{"id":"/docs/getting-started-65","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#why-byte-helpers-exist","content":"String-native formats do not pretend otherwise. Nanoid and CUID v2 have no canonical byte encoding, so they expose a smaller API."},"191":{"id":"/docs/getting-started-66","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#write-into-a-caller-owned-buffer","content":"Binary formats can also write directly into a buffer when an integration already owns the allocation:"},"192":{"id":"/docs/getting-started-67","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#write-into-a-caller-owned-buffer","content":"Public inputs are validated. Explicit random bytes and buffer offsets make tests and boundary integrations deterministic without changing the generator's default monotonic state."},"193":{"id":"/docs/guides/choosing-an-id","page_id":"/docs/guides/choosing-an-id","type":"page","content":"Choosing an ID","breadcrumbs":["Docs","Guides"],"tags":[],"url":"/docs/guides/choosing-an-id"},"194":{"id":"/docs/guides/choosing-an-id-0","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Choose for the system boundary, not the trend."},"195":{"id":"/docs/guides/choosing-an-id-1","page_id":"/docs/guides/choosing-an-id","type":"heading","tags":[],"url":"/docs/guides/choosing-an-id#a-good-default","content":"A good default"},"196":{"id":"/docs/guides/choosing-an-id-2","page_id":"/docs/guides/choosing-an-id","type":"heading","tags":[],"url":"/docs/guides/choosing-an-id#an-id-derived-from-something-you-already-have","content":"An ID derived from something you already have"},"197":{"id":"/docs/guides/choosing-an-id-3","page_id":"/docs/guides/choosing-an-id","type":"heading","tags":[],"url":"/docs/guides/choosing-an-id#time-ordering-is-local","content":"Time ordering is local"},"198":{"id":"/docs/guides/choosing-an-id-4","page_id":"/docs/guides/choosing-an-id","type":"heading","tags":[],"url":"/docs/guides/choosing-an-id#time-order-leaks-creation-time","content":"Time order leaks creation time"},"199":{"id":"/docs/guides/choosing-an-id-5","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Different identifiers optimize for different constraints. Start with the boundary the value crosses: database index, URL, public API, MongoDB collection, or a native integer column."},"200":{"id":"/docs/guides/choosing-an-id-6","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Situation"},"201":{"id":"/docs/guides/choosing-an-id-7","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Choose"},"202":{"id":"/docs/guides/choosing-an-id-8","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Why"},"203":{"id":"/docs/guides/choosing-an-id-9","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Database primary keys"},"204":{"id":"/docs/guides/choosing-an-id-10","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"UUID v7 or ULID"},"205":{"id":"/docs/guides/choosing-an-id-11","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Time-ordered values improve index locality."},"206":{"id":"/docs/guides/choosing-an-id-12","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Public API resources"},"207":{"id":"/docs/guides/choosing-an-id-13","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"TypeID"},"208":{"id":"/docs/guides/choosing-an-id-14","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"UUID v7 with a readable, domain-specific prefix."},"209":{"id":"/docs/guides/choosing-an-id-15","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Short URLs and invite codes"},"210":{"id":"/docs/guides/choosing-an-id-16","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Nanoid"},"211":{"id":"/docs/guides/choosing-an-id-17","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Compact and URL-safe."},"212":{"id":"/docs/guides/choosing-an-id-18","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Values that should resist enumeration"},"213":{"id":"/docs/guides/choosing-an-id-19","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"CUID v2"},"214":{"id":"/docs/guides/choosing-an-id-20","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Non-sequential, secure identifier."},"215":{"id":"/docs/guides/choosing-an-id-21","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"MongoDB `_id` compatibility"},"216":{"id":"/docs/guides/choosing-an-id-22","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"ObjectID"},"217":{"id":"/docs/guides/choosing-an-id-23","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Matches MongoDB's 12-byte ObjectID format."},"218":{"id":"/docs/guides/choosing-an-id-24","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Go rs/xid compatibility"},"219":{"id":"/docs/guides/choosing-an-id-25","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"XID"},"220":{"id":"/docs/guides/choosing-an-id-26","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Matches rs/xid's compact 12-byte text and binary format."},"221":{"id":"/docs/guides/choosing-an-id-27","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Native `BIGINT` storage"},"222":{"id":"/docs/guides/choosing-an-id-28","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"TSID"},"223":{"id":"/docs/guides/choosing-an-id-29","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"A sortable 64-bit integer, not a UUID-shaped string."},"224":{"id":"/docs/guides/choosing-an-id-30","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Broad standards compatibility"},"225":{"id":"/docs/guides/choosing-an-id-31","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"UUID v4"},"226":{"id":"/docs/guides/choosing-an-id-32","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"The conventional random UUID format."},"227":{"id":"/docs/guides/choosing-an-id-33","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"An ID derived from something you already have"},"228":{"id":"/docs/guides/choosing-an-id-34","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"UUID v5"},"229":{"id":"/docs/guides/choosing-an-id-35","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"The same name and namespace always give the same UUID, with no state to keep."},"230":{"id":"/docs/guides/choosing-an-id-36","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#a-good-default","content":"If you create records in more than one service or need an ID before inserting a row, start with UUID v7. It is a UUID-native value, sort-friendly, and uses a familiar database column type."},"231":{"id":"/docs/guides/choosing-an-id-37","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#an-id-derived-from-something-you-already-have","content":"Every other generator creates a new value on each call. Sometimes you need the opposite: an ID that is a pure function of an identifier you already hold, such as a session ID issued by a third-party tool. The same input must give the same output in another process, on another machine, or after a reinstall, with no lookup table to keep."},"232":{"id":"/docs/guides/choosing-an-id-38","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#an-id-derived-from-something-you-already-have","content":"UUID v5 does this. It hashes a namespace and a name, so the function is the table:"},"233":{"id":"/docs/guides/choosing-an-id-39","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#an-id-derived-from-something-you-already-have","content":"A UUID v5 has no timestamp and no useful order, and it is an identifier, not a secret: anyone who knows the name and namespace can compute it. See UUID v5 for namespaces, composing inputs, and string encoding."},"234":{"id":"/docs/guides/choosing-an-id-40","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#time-ordering-is-local","content":"UUID v7, ULID, ObjectID, XID, and TSID carry time information. uniku keeps the state required for monotonic sequencing inside one JavaScript isolate; it does not coordinate clocks or sequences between processes or machines."},"235":{"id":"/docs/guides/choosing-an-id-41","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#time-order-leaks-creation-time","content":"UUID v7, ULID, KSUID, ObjectID, XID, and TSID embed a creation timestamp in the identifier itself. Anyone who can read the ID can decode when the record was created, not just its order relative to other records. That is a feature for index locality and a leak if the ID is public and the creation time is sensitive, for example a document, invoice, or account that should not reveal how old it is. If the identifier is exposed outside your system and creation time must stay private, use UUID v4, CUID v2, or Nanoid instead: none of them encode a timestamp."},"236":{"id":"/docs/guides/integrations","page_id":"/docs/guides/integrations","type":"page","content":"Integrations","breadcrumbs":["Docs","Guides"],"tags":[],"url":"/docs/guides/integrations"},"237":{"id":"/docs/guides/integrations-0","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations","content":"Runnable starting points for Hono, Drizzle ORM v1, and Effect v4."},"238":{"id":"/docs/guides/integrations-1","page_id":"/docs/guides/integrations","type":"heading","tags":[],"url":"/docs/guides/integrations#hono-request-ids-with-nanoid","content":"Hono request IDs with Nanoid"},"239":{"id":"/docs/guides/integrations-2","page_id":"/docs/guides/integrations","type":"heading","tags":[],"url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"Drizzle ORM v1 with binary ULIDs"},"240":{"id":"/docs/guides/integrations-3","page_id":"/docs/guides/integrations","type":"heading","tags":[],"url":"/docs/guides/integrations#effect-v4-services-with-typeid","content":"Effect v4 services with TypeID"},"241":{"id":"/docs/guides/integrations-4","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations","content":"The examples below add Nanoid request IDs to Hono, binary ULIDs to a Drizzle schema, and prefixed TypeIDs to an Effect service. Each is self-contained and runs with the command below it."},"242":{"id":"/docs/guides/integrations-5","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#hono-request-ids-with-nanoid","content":"Hono's request ID middleware accepts a synchronous `generator`. When a request does not already carry a valid `X-Request-Id` header, this example generates a compact Nanoid, stores it in the request context, and returns it in the response header."},"243":{"id":"/docs/guides/integrations-6","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#hono-request-ids-with-nanoid","content":"Run it with `pnpm --filter @uniku/examples example:hono`."},"244":{"id":"/docs/guides/integrations-7","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"The `binaryUlid` custom type exposes a string to application code while declaring a PostgreSQL `bytea` column. Its Drizzle codec converts ULID strings to `Uint8Array` parameters and selected bytes back to canonical ULID strings."},"245":{"id":"/docs/guides/integrations-8","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"The column's `$defaultFn` generates a ULID when an insert omits `id`. Both sides of the foreign key remain 16-byte values in PostgreSQL, so the join compares their binary representation while the returned `eventId` is already a string. The example uses an in-memory PGlite database, so it needs no external PostgreSQL server."},"246":{"id":"/docs/guides/integrations-9","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"Run it with `pnpm --filter @uniku/examples example:drizzle`."},"247":{"id":"/docs/guides/integrations-10","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"The example pins Drizzle ORM `1.0.0-rc.4`. Codecs are configured per PostgreSQL type, so this client treats every `bytea` column as a binary ULID. The v1 line is still a release candidate, so check its release notes before changing that version."},"248":{"id":"/docs/guides/integrations-11","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#effect-v4-services-with-typeid","content":"An Effect service keeps ID generation injectable without leaking framework types into the generated value. This service exposes a traced `next()` effect and returns TypeID strings with a stable `user_` prefix."},"249":{"id":"/docs/guides/integrations-12","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#effect-v4-services-with-typeid","content":"Run it with `pnpm --filter @uniku/examples example:effect`."},"250":{"id":"/docs/guides/integrations-13","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#effect-v4-services-with-typeid","content":"This example pins Effect `4.1.3`. Check the Effect release notes before changing that version."},"251":{"id":"/docs/guides/performance","page_id":"/docs/guides/performance","type":"page","content":"Performance and bundle size","breadcrumbs":["Docs","Guides"],"tags":[],"url":"/docs/guides/performance"},"252":{"id":"/docs/guides/performance-0","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance","content":"Recorded generation benchmarks, measurement methodology, and the bundle cost of each import."},"253":{"id":"/docs/guides/performance-1","page_id":"/docs/guides/performance","type":"heading","tags":[],"url":"/docs/guides/performance#generation-speed","content":"Generation speed"},"254":{"id":"/docs/guides/performance-2","page_id":"/docs/guides/performance","type":"heading","tags":[],"url":"/docs/guides/performance#bundle-size","content":"Bundle size"},"255":{"id":"/docs/guides/performance-3","page_id":"/docs/guides/performance","type":"heading","tags":[],"url":"/docs/guides/performance#reproduce-these-numbers","content":"Reproduce these numbers"},"256":{"id":"/docs/guides/performance-4","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance","content":"Generation speed is a primary design constraint in uniku. Results depend on the format: in this snapshot, Nanoid 6 and BSON ObjectID generate faster than uniku, while the other measured formats favor uniku. Application performance still depends on where and how IDs are created."},"257":{"id":"/docs/guides/performance-5","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"This snapshot comes from a four-repetition CI run on November 15, 2026 (UTC), using Node.js 25.9.0 on a GitHub-hosted `ubuntu-latest` runner. The measured library revision is `6d0725e`. Its library source, reference dependencies, runtime pins, and benchmark inputs are unchanged in `ca8b953`."},"258":{"id":"/docs/guides/performance-6","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Each ratio divides uniku's median throughput by the reference package's median throughput. Values above 1 favor uniku; values below 1 favor the reference. These are approximate shared-runner measurements, with noticeable variation in some reference rows, rather than guarantees for every runtime or workload. Recorded results preserve the action-level measurements; the rolling baseline tracks later CI runs."},"259":{"id":"/docs/guides/performance-7","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Generator"},"260":{"id":"/docs/guides/performance-8","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Reference"},"261":{"id":"/docs/guides/performance-9","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"uniku / reference throughput"},"262":{"id":"/docs/guides/performance-10","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"UUID v4"},"263":{"id":"/docs/guides/performance-11","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`uuid@14.0.3`"},"264":{"id":"/docs/guides/performance-12","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"1.2×"},"265":{"id":"/docs/guides/performance-13","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"UUID v5 (short name)"},"266":{"id":"/docs/guides/performance-14","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`uuid@14.0.3`"},"267":{"id":"/docs/guides/performance-15","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"3.0×"},"268":{"id":"/docs/guides/performance-16","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"UUID v5 (256-char name)"},"269":{"id":"/docs/guides/performance-17","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`uuid@14.0.3`"},"270":{"id":"/docs/guides/performance-18","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"2.0×"},"271":{