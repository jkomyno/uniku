asured from the same source with `tsdown@0.22.3`, minification, and gzip level 9:"},"303":{"id":"/docs/guides/performance-51","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"Import"},"304":{"id":"/docs/guides/performance-52","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"Minified + gzipped"},"305":{"id":"/docs/guides/performance-53","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/uuid/v4`"},"306":{"id":"/docs/guides/performance-54","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.2 KB"},"307":{"id":"/docs/guides/performance-55","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/uuid/v5`"},"308":{"id":"/docs/guides/performance-56","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.8 KB"},"309":{"id":"/docs/guides/performance-57","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/uuid/v7`"},"310":{"id":"/docs/guides/performance-58","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.7 KB"},"311":{"id":"/docs/guides/performance-59","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/ulid`"},"312":{"id":"/docs/guides/performance-60","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.9 KB"},"313":{"id":"/docs/guides/performance-61","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/typeid`"},"31