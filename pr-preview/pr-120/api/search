:557,"497":212,"498":636,"499":216,"500":593,"501":560,"502":307,"503":308,"504":309,"505":305,"506":304,"507":295,"508":300,"509":298,"510":301,"511":310,"512":303,"513":296,"514":426,"515":635,"516":424,"517":425,"518":466,"519":431,"520":89,"521":167,"522":34,"523":214,"524":437,"525":33,"526":619,"527":239,"528":0,"529":343,"530":104,"531":67,"532":465,"533":152,"534":68,"535":359,"536":85,"537":66,"538":313,"539":124,"540":480,"541":96,"542":601,"543":383,"544":423,"545":585,"546":499,"547":180,"548":122,"549":261,"550":331,"551":90,"552":105,"553":259,"554":509,"555":92,"556":106,"557":260,"558":315,"559":147,"560":107,"561":187,"562":334,"563":145,"564":108,"565":188,"566":335,"567":95,"568":109,"569":189,"570":333,"571":164,"572":110,"573":290,"574":362,"575":130,"576":111,"577":291,"578":376,"579":166,"580":112,"581":266,"582":375,"583":128,"584":113,"585":142,"586":323,"587":77,"588":114,"589":139,"590":322,"591":75,"592":115,"593":140,"594":321,"595":73,"596":116,"597":141,"598":320,"599":162,"600":117,"601":200,"602":337,"603":160,"604":118,"605":201,"606":336,"607":158,"608":119,"609":202,"610":338,"611":246,"612":120,"613":257,"614":332,"615":88,"616":121,"617":262,"618":314,"619":84,"620":86,"621":263,"622":316,"623":99,"624":153,"625":264,"626":357,"627":103,"628":154,"629":265,"630":358,"631":101,"632":155,"633":258,"634":360,"635":149,"636":156,"637":292,"638":363,"639":283,"640":123,"641":203,"642":324,"643":610,"644":217,"645":97,"646":493,"647":622,"648":494,"649":516,"650":386,"651":519,"652":135,"653":531,"654":506,"655":532,"656":632,"657":625,"658":633,"659":574,"660":354,"661":641,"662":671,"663":705,"664":626,"665":642,"666":196,"667":329,"668":198,"669":646,"670":583,"671":647,"672":675,"673":558,"674":676,"675":667,"676":679,"677":512,"678":399,"679":379,"680":387,"681":588,"682":361,"683":522,"684":703,"685":345,"686":427,"687":682,"688":591,"689":507,"690":592,"691":273,"692":440,"693":415,"694":328,"695":330,"696":341,"697":576,"698":340,"699":311,"700":655,"701":197,"702":589,"703":318,"704":319,"705":312,"706":351,"707":688,"708":623,"709":689,"710":711,"711":385,"712":712,"713":598,"714":481},"orderedDocs":[[528,"(abstract)"],[321,"**Everything here is one engine.** These are Node.js numbers on V8, and several\nhot paths are unrolled for it. Bun, Deno, and browser engines are covered by the\ncorrectness matrix, not by these measurements."],[318,"**One row is a control.** `uuid@14`'s no-argument `v4()` and uniku's no-argument\n`uuidv4()` both return `crypto.randomUUID()` directly, so there is no generation\ndifference between them to measure. Any deviation from 1× on that row is the\nmeasured noise floor of this harness, and it has been observed between 1.2× and\n1.6×."],[320,"**The ULID row measures the reference's overhead.** `ulid@3.0.2` runs\n`detectPRNG()` — feature detection plus `detectRoot()` — on every `ulid()` call,\nthen draws its 16 random characters through 16 separate\n`getRandomValues(new Uint8Array(1))` calls, and builds the string by prepending.\nThat is a real property of that package, and it dominates the ratio."],[317,"**They are not reproducible to the digit.** Two runs of the same command on the\nsame machine moved the small-ratio rows by up to 22% (UUID v4, TSID, ObjectID,\nXID), and a different machine moved the ULID row from 163× to \\~85×. That is why\nthe table reports ranges rounded to about one significant figure instead of the\nfour significant figures a single run prints."],[319,"**Two rows are not like-for-like on work done.** The TypeID, KSUID, and TSID rows\ncompare uniku returning its primary value directly against a reference that\nallocates an object first. That gap is real for callers, but it measures API shape\nas much as encoding speed."],[295,"\\~0.6–0.65×"],[307,"\\~0.6–0.7×"],[291,"\\~0.65×"],[344,"\\~1.0 KB"],[346,"\\~1.0 KB"],[334,"\\~1.2 KB"],[348,"\\~1.2 KB"],[315,"\\~1.3×"],[275,"\\~1.4–2×"],[350,"\\~1.5 KB"],[303,"\\~1.5–1.7×"],[352,"\\~1.6 KB"],[338,"\\~1.7 KB"],[354,"\\~1.7 KB"],[336,"\\~1.8 KB"],[340,"\\~1.9 KB"],[267,"\\~1×"],[360,"\\~101 B"],[311,"\\~2–2.6×"],[271,"\\~2–3×"],[356,"\\~2.1 KB"],[287,"\\~2.5–3.5×"],[342,"\\~2.9 KB"],[358,"\\~445 B"],[279,"\\~6–7.5×"],[299,"\\~7–9×"],[283,"\\~85–165×"],[525,"`_tag`"],[522,"`_tag` for discriminated matching, compatible with Effect's `catchTag`."],[69,"`--alphabet`"],[26,"`--count`"],[29,"`--json`"],[110,"`--json`"],[121,"`--json`"],[66,"`--length`"],[76,"`--length`"],[43,"`--lowercase`"],[53,"`--lowercase`"],[49,"`--monotonic`"],[39,"`--name`"],[41,"`--namespace`"],[101,"`--node-bits`"],[99,"`--node`"],[59,"`--prefix`"],[119,"`--quiet`"],[117,"`--stdin`"],[51,"`--timestamp`"],[82,"`--timestamp`"],[87,"`--timestamp`"],[92,"`--timestamp`"],[97,"`--timestamp`"],[108,"`--type`"],[115,"`--type`"],[36,"`--uuid-version`"],[70,"`-a`"],[67,"`-l`"],[77,"`-l`"],[27,"`-n`"],[60,"`-p`"],[37,"`-v`"],[537,"`'BufferError'`"],[531,"`'InvalidInputError'`"],[534,"`'ParseError'`"],[302,"`@owpz/ksuid@25.7.21`"],[298,"`@paralleldrive/cuid2@3.3.0`"],[16,"`@uniku/cli` is the command-line companion to the library. It is useful when an ID belongs in a shell pipeline, a migration, or a one-off diagnostic instead of your application source. It supports every generator in the library: UUID v4/v5/v7, ULID, TypeID, CUID v2, Nanoid, KSUID, MongoDB ObjectID, XID, and TSID."],[475,"`ALPHABET_DUPLICATE`"],[595,"`ALPHABET_DUPLICATE`"],[473,"`ALPHABET_INVALID_CHAR`"],[591,"`ALPHABET_INVALID_CHAR`"],[471,"`ALPHABET_OUT_OF_RANGE`"],[587,"`ALPHABET_OUT_OF_RANGE`"],[323,"`bench-results.ts` carries the statistics:"],[327,"`bench-summary` prints the combined dispersion for the ratio as a `Spread`\ncolumn, and labels a row `parity (within spread)` when its deviation from 1× is\nsmaller than that spread."],[364,"`bench:compat` runs uniku and the reference packages in separate processes;\n`bench:summary` reads those results and prints a comparison table. CI repeats the\ncompatibility run four times wi