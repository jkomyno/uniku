/getting-started#every-strategy","content":"TSID"},"184":{"id":"/docs/getting-started-59","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#every-strategy","content":"`uniku/tsid`"},"185":{"id":"/docs/getting-started-60","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#every-strategy","content":"`tsid()`"},"186":{"id":"/docs/getting-started-61","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#every-strategy","content":"`bigint`"},"187":{"id":"/docs/getting-started-62","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#every-strategy","content":"See Choosing an ID for the trade-offs, or open a generator reference when you already know which format you need."},"188":{"id":"/docs/getting-started-63","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#why-byte-helpers-exist","content":"UUIDs, ULIDs, TypeIDs, KSUIDs, ObjectIDs, XIDs, and TSIDs have a canonical binary representation. Their `toBytes()` and `fromBytes()` helpers let you store and transport that representation without inventing a second codec."},"189":{"id":"/docs/getting-started-64","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#why-byte-helpers-exist","content":"This matters when an ID lives in a binary database column, a compact protocol payload, or a cache key. A UUID, for instance, is 16 bytes instead of its 36-character string form. The helpers also make the string boundary explicit: convert when data leaves your application, preserve bytes where the system already handles bytes."},"190":{"id":"/docs/getting-started-65","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#why-byte-helpers-exist","content":"String-native formats do not pretend otherwise. Nanoid and CUID v2 have no canonical byte encoding, so they expose a smaller API."},"191":{"id":"/docs/getting-started-66","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#write-into-a-caller-owned-buffer","content":"Binary formats can also write directly into a buffer when an integration already owns the allocation:"},"192":{"id":"/docs/getting-started-67","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#write-into-a-caller-owned-buffer","content":"Public inputs are validated. Explicit random bytes and buffer offsets make tests and boundary integrations deterministic without changing the generator's default monotonic state."},"193":{"id":"/docs/guides/choosing-an-id","page_id":"/docs/guides/choosing-an-id","type":"page","content":"Choosing an ID","breadcrumbs":["Docs","Guides"],"tags":[],"url":"/docs/guides/choosing-an-id"},"194":{"id":"/docs/guides/choosing-an-id-0","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Choose for the system boundary, not the trend."},"195":{"id":"/docs/guides/choosing-an-id-1","page_id":"/docs/guides/choosing-an-id","type":"heading","tags":[],"url":"/docs/guides/choosing-an-id#a-good-default","content":"A good default"},"196":{"id":"/docs/guides/choosing-an-id-2","page_id":"/docs/guides/choosing-an-id","type":"heading","tags":[],"url":"/docs/guides/choosing-an-id#an-id-derived-from-something-you-already-have","content":"An ID derived from something you already have"},"197":{"id":"/docs/guides/choosing-an-id-3","page_id":"/docs/guides/choosing-an-id","type":"heading","tags":[],"url":"/docs/guides/choosing-an-id#time-ordering-is-local","content":"Time ordering is local"},"198":{"id":"/docs/guides/choosing-an-id-4","page_id":"/docs/guides/choosing-an-id","type":"heading","tags":[],"url":"/docs/guides/choosing-an-id#time-order-leaks-creation-time","content":"Time order leaks creation time"},"199":{"id":"/docs/guides/choosing-an-id-5","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Different identifiers optimize for different constraints. Start with the boundary the value crosses: database index, URL, public API, MongoDB collection, or a native integer column."},"200":{"id":"/docs/guides/choosing-an-id-6","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Situation"},"201":{"id":"/docs/guides/choosing-an-id-7","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Choose"},"202":{"id":"/docs/guides/choosing-an-id-8","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Why"},"203":{"id":"/docs/guides/choosing-an-id-9","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Database primary keys"},"204":{"id":"/docs/guides/choosing-an-id-10","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"UUID v7 or ULID"},"205":{"id":"/docs/guides/choosing-an-id-11","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Time-ordered values improve index locality."},"206":{"id":"/docs/guides/choosing-an-id-12","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Public API resources"},"207":{"id":"/docs/guides/choosing-an-id-13","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"TypeID"},"208":{"id":"/docs/guides/choosing-an-id-14","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"UUID v7 with a readable, domain-specific prefix."},"209":{"id":"/docs/guides/choosing-an-id-15","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Short URLs and invite codes"},"210":{"id":"/docs/guides/choosing-an-id-16","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Nanoid"},"211":{"id":"/docs/guides/choosing-an-id-17","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Compact and URL-safe."},"212":{"id":"/docs/guides/choosing-an-id-18","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Values that should resist enumeration"},"213":{"id":"/docs/guides/choosing-an-id-19","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"CUID v2"},"214":{"id":"/docs/guides/choosing-an-id-20","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Non-sequential, secure identifier."},"215":{"id":"/docs/guides/choosing-an-id-21","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"MongoDB `_id` compatibility"},"216":{"id":"/docs/guides/choosing-an-id-22","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"ObjectID"},"217":{"id":"/docs/guides/choosing-an-id-23","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Matches MongoDB's 12-byte ObjectID format."},"218":{"id":"/docs/guides/choosing-an-id-24","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Go rs/xid compatibility"},"219":{"id":"/docs/guides/choosing-an-id-25","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"XID"},"220":{"id":"/docs/guides/choosing-an-id-26","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Matches rs/xid's compact 12-byte text and binary format."},"221":{"id":"/docs/guides/choosing-an-id-27","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Native `BIGINT` storage"},"222":{"id":"/docs/guides/choosing-an-id-28","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"TSID"},"223":{"id":"/docs/guides/choosing-an-id-29","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"A sortable 64-bit integer, not a UUID-shaped string."},"224":{"id":"/docs/guides/choosing-an-id-30","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Broad standards compatibility"},"225":{"id":"/docs/guides/choosing-an-id-31","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"UUID v4"},"226":{"id":"/docs/guides/choosing-an-id-32","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"The conventional random UUID format."},"227":{"id":"/docs/guides/choosing-an-id-33","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"An ID derived from something you already have"},"228":{"id":"/docs/guides/choosing-an-id-34","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"UUID v5"},"229":{"id":"/docs/guides/choosing-an-id-35","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"The same name and namespace always give the same UUID, with no state to keep."},"230":{"id":"/docs/guides/choosing-an-id-36","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#a-good-default","content":"If you create records in more than one service or need an ID before inserting a row, start with UUID v7. It is a UUID-native value, sort-friendly, and uses a familiar database column type."},"231":{"id":"/docs/guides/choosing-an-id-37","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#an-id-derived-from-something-you-already-have","content":"Every other generator creates a new value on each call. Sometimes you need the opposite: an ID that is a pure function of an identifier you already hold, such as a session ID issued by a third-party tool. The same input must give the same output in another process, on another machine, or after a reinstall, with no lookup table to keep."},"232":{"id":"/docs/guides/choosing-an-id-38","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#an-id-derived-from-something-you-already-have","content":"UUID v5 does this. It hashes a namespace and a name, so the function is the table:"},"233":{"id":"/docs/guides/choosing-an-id-39","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#an-id-derived-from-something-you-already-have","content":"A UUID v5 has no timestamp and no useful order, and it is an identifier, not a secret: anyone who knows the name and namespace can compute it. See UUID v5 for namespaces, composing inputs, and string encoding."},"234":{"id":"/docs/guides/choosing-an-id-40","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#time-ordering-is-local","content":"UUID v7, ULID, ObjectID, XID, and TSID carry time information. uniku keeps the state required for monotonic sequencing inside one JavaScript isolate; it does not coordinate clocks or sequences between processes or machines."},"235":{"id":"/docs/guides/choosing-an-id-41","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#time-order-leaks-creation-time","content":"UUID v7, ULID, KSUID, ObjectID, XID, and TSID embed a creation timestamp in the identifier itself. Anyone who can read the ID can decode when the record was created, not just its order relative to other records. That is a feature for index locality and a leak if the ID is public and the creation time is sensitive, for example a document, invoice, or account that should not reveal how old it is. If the identifier is exposed outside your system and creation time must stay private, use UUID v4, CUID v2, or Nanoid instead: none of them encode a timestamp."},"236":{"id":"/docs/guides/integrations","page_id":"/docs/guides/integrations","type":"page","content":"Integrations","breadcrumbs":["Docs","Guides"],"tags":[],"url":"/docs/guides/integrations"},"237":{"id":"/docs/guides/integrations-0","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations","content":"Runnable starting points for Hono, Drizzle ORM v1, and Effect v4."},"238":{"id":"/docs/guides/integrations-1","page_id":"/docs/guides/integrations","type":"heading","tags":[],"url":"/docs/guides/integrations#hono-request-ids-with-nanoid","content":"Hono request IDs with Nanoid"},"239":{"id":"/docs/guides/integrations-2","page_id":"/docs/guides/integrations","type":"heading","tags":[],"url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"Drizzle ORM v1 with binary ULIDs"},"240":{"id":"/docs/guides/integrations-3","page_id":"/docs/guides/integrations","type":"heading","tags":[],"url":"/docs/guides/integrations#effect-v4-services-with-typeid","content":"Effect v4 services with TypeID"},"241":{"id":"/docs/guides/integrations-4","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations","content":"The examples below add Nanoid request IDs to Hono, binary ULIDs to a Drizzle schema, and prefixed TypeIDs to an Effect service. Each is self-contained and runs with the command below it."},"242":{"id":"/docs/guides/integrations-5","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#hono-request-ids-with-nanoid","content":"Hono's request ID middleware accepts a synchronous `generator`. When a request does not already carry a valid `X-Request-Id` header, this example generates a compact Nanoid, stores it in the request context, and returns it in the response header."},"243":{"id":"/docs/guides/integrations-6","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#hono-request-ids-with-nanoid","content":"Run it with `pnpm --filter @uniku/examples example:hono`."},"244":{"id":"/docs/guides/integrations-7","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"The `binaryUlid` custom type exposes a string to application code while declaring a PostgreSQL `bytea` column. Its Drizzle codec converts ULID strings to `Uint8Array` parameters and selected bytes back to canonical ULID strings."},"245":{"id":"/docs/guides/integrations-8","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"The column's `$defaultFn` generates a ULID when an insert omits `id`. Both sides of the foreign key remain 16-byte values in PostgreSQL, so the join compares their binary representation while the returned `eventId` is already a string. The example uses an in-memory PGlite database, so it needs no external PostgreSQL server."},"246":{"id":"/docs/guides/integrations-9","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"Run it with `pnpm --filter @uniku/examples example:drizzle`."},"247":{"id":"/docs/guides/integrations-10","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"The example pins Drizzle ORM `1.0.0-rc.4`. Codecs are configured per PostgreSQL type, so this client treats every `bytea` column as a binary ULID. The v1 line is still a release candidate, so check its release notes before changing that version."},"248":{"id":"/docs/guides/integrations-11","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#effect-v4-services-with-typeid","content":"An Effect service keeps ID generation injectable without leaking framework types into the generated value. This service exposes a traced `next()` effect and returns TypeID strings with a stable `user_` prefix."},"249":{"id":"/docs/guides/integrations-12","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#effect-v4-services-with-typeid","content":"Run it with `pnpm --filter @uniku/examples example:effect`."},"250":{"id":"/docs/guides/integrations-13","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#effect-v4-services-with-typeid","content":"This example pins Effect `4.1.3`. Check the Effect release notes before changing that version."},"251":{"id":"/docs/guides/performance","page_id":"/docs/guides/performance","type":"page","content":"Performance and bundle size","breadcrumbs":["Docs","Guides"],"tags":[],"url":"/docs/guides/performance"},"252":{"id":"/docs/guides/performance-0","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance","content":"Recorded generation benchmarks, measurement methodology, and the bundle cost of each import."},"253":{"id":"/docs/guides/performance-1","page_id":"/docs/guides/performance","type":"heading","tags":[],"url":"/docs/guides/performance#generation-speed","content":"Generation speed"},"254":{"id":"/docs/guides/performance-2","page_id":"/docs/guides/performance","type":"heading","tags":[],"url":"/docs/guides/performance#how-to-read-these-numbers","content":"How to read these numbers"},"255":{"id":"/docs/guides/performance-3","page_id":"/docs/guides/performance","type":"heading","tags":[],"url":"/docs/guides/performance#methodology","content":"Methodology"},"256":{"id":"/docs/guides/performance-4","page_id":"/docs/guides/performance","type":"heading","tags":[],"url":"/docs/guides/performance#bundle-size","content":"Bundle size"},"257":{"id":"/docs/guides/performance-5","page_id":"/docs/guides/performance","type":"heading","tags":[],"url":"/docs/guides/performance#reproduce-these-numbers","content":"Reproduce these numbers"},"258":{"id":"/docs/guides/performance-6","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance","content":"Generation speed is a design constraint in uniku, so the numbers are published\nrather than asserted. Results depend on the format: in this snapshot, Nanoid 6 and\nBSON ObjectID generate faster than uniku, while the other measured formats favor\nuniku. Application performance still depends on where and how IDs are created."},"259":{"id":"/docs/guides/performance-7","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance","content":"Treat every ratio on this page as an order of magnitude, not a guarantee. Read\nhow to read these numbers before quoting one."},"260":{"id":"/docs/guides/performance-8","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"The ranges below combine a four-repetition CI run\non November 15, 2026 (UTC) with repeat runs of the same command on different\nhardware. Node.js `25.9.0`, GitHub-hosted `ubuntu-latest` for the CI half. Each\nratio divides uniku's median throughput by the reference package's median\nthroughput; values above 1 favor uniku."},"261":{"id":"/docs/guides/performance-9","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Generator"},"262":{"id":"/docs/guides/performance-10","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Reference"},"263":{"id":"/docs/guides/performance-11","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"uniku / reference"},"264":{"id":"/docs/guides/performance-12","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"What the row actually compares"},"265":{"id":"/docs/guides/performance-13","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"UUID v4"},"266":{"id":"/docs/guides/performance-14","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`uuid@14.0.3`"},"267":{"id":"/docs/guides/performance-15","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"\\~1×"},"268":{"id":"/docs/guides/performance-16","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Control row: both sides call `crypto.randomUUID()`"},"269":{"id":"/docs/guides/performance-17","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"UUID v5 (short name)"},"270":{"id":"/docs/guides/performance-18","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`uuid@14.0.3`"},"271":{"id":"/docs/guides/performance-19","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"\\~2–3×"},"272":{"id":"/docs/guides/performance-20","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"SHA-1 over a 15-byte name"},"273":{"id":"/docs/guides/performance-21","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"UUID v5 (256-char name)"},"274":{"id":"/docs/guides/performance-22","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`uuid@14.0.3`"},"275":{"id":"/docs/guides/performance-23","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"\\~1.4–2×"},"276":{"id":"/docs/guides/performance-24","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"SHA-1 over a 256-byte name"},"277":{"id":"/docs/guides/performance-25","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"UUID v7"},"278":{"id":"/docs/guides/performance-26","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`uuid@14.0.3`"},"279":{"id":"/docs/guides/performance-27","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"\\~6–7.5×"},"280":{"id":"/docs/guides/performance-28","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Both encode timestamp, counter, and random tail"},"281":{"id":"/docs/guides/performance-29","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"ULID"},"282":{"id":"/docs/guides/performance-30","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`ulid@3.0.2`"},"283":{"id":"/docs/guides/performance-31","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"\\~85–165×"},"284":{"id":"/docs/guides/performance-32","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"The reference re-detects its PRNG and draws 16 single bytes per call"},"285":{"id":"/docs/guides/performance-33","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"TypeID"},"286":{"id":"/docs/guides/performance-34","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`typeid-js@1.2.0`"},"287":{"id":"/docs/guides/performance-35","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"\\~2.5–3.5×"},"288":{"id":"/docs/guides/performance-36","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"uniku returns a string; the reference builds an object, then calls `toString()`"},"289":{"id":"/docs/guides/performance-37","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Nanoid (21 chars)"},"290":{"id":"/docs/guides/performance-38","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`nanoid@6.0.2`"},"291":{"id":"/docs/guides/performance-39","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"\\~0.65×"},"292":{"id":"/docs/guides/performance-40","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Both draw from a pooled random source"},"293":{"id":"/docs/guides/performance-41","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Nanoid (10 chars)"},"294":{"id":"/docs/guides/performance-42","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`nanoid@6.0.2`"},"295":{"id":"/docs/guides/performance-43","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"\\~0.6–0.65×"},"296":{"id":"/docs/guides/performance-44","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Same, with a shorter output"},"297":{"id":"/docs/guides/performance-45","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"CUID2"},"298":{"id":"/docs/guides/performance-46","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`@paralleldrive/cuid2@3.3.0`"},"299":{"id":"/docs/guides/performance-47","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"\\~7–9×"},"300":{"id":"/docs/guides/performance-48","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"SHA3-512 over time, salt, counter, and fingerprint"},"301":{"id":"/docs/guides/performance-49","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"KSUID"},"302":{"id":"/docs/guides/performance-50","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`@owpz/ksuid@25.7.21`"},"303":{"id":"/docs/guides/performance-51","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"\\~1.5–1.7×"},"304":{"id":"/docs/guides/performance-52","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"uniku returns a string; the reference builds a KSUID object"},"305":{"id":"/docs/guides/performance-53","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"ObjectID"},"306":{"id":"/docs/guides/performance-54","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`bson@7.3.4`"},"307":{"id":"/docs/guides/performance-55","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"\\~0.6–0.7×"},"308":{"id":"/docs/guides/performance-56","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Both cache the process-random field and increment a 24-bit counter"},"309":{"id":"/docs/guides/performance-57","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"TSID"},"310":{"id":"/docs/guides/performance-58","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`tsid-ts@0.0.9`"},"311":{"id":"/docs/guides/performance-59","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"\\~2–2.6×"},"312":{"id":"/docs/guides/performance-60","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"uniku returns a `bigint`; the reference builds a TSID object"},"313":{"id":"/docs/guides/performance-61","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"XID"},"314":{"id":"/docs/guides/performance-62","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"`nexid@2.1.0`"},"315":{"id":"/docs/guides/performance-63","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"\\~1.3×"},"316":{"id":"/docs/guides/performance-64","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Both encode seconds, identity, and a 24-bit counter"},"317":{"id":"/docs/guides/performance-65","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#how-to-read-these-numbers","content":"**They are not reproducible to the digit.** Two runs of the same command on the\nsame machine moved the small-ratio rows by up to 22% (UUID v4, TSID, ObjectID,\nXID), and a different machine moved the ULID row from 163× to \\~85×. That is why\nthe table reports ranges rounded to about one significant figure instead of the\nfour significant figures a single run prints."},"318":{"id":"/docs/guides/performance-66","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#how-to-read-these-numbers","content":"**One row is a control.** `uuid@14`'s no-argument `v4()` and uniku's no-argument\n`uuidv4()` both return `crypto.randomUUID()` directly, so there is no generation\ndifference between them to measure. Any deviation from 1× on that row is the\nmeasured noise floor of this harness, and it has been observed between 1.2× and\n1.6×."},"319":{"id":"/docs/guides/performance-67","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#how-to-read-these-numbers","content":"**Two rows are not like-for-like on work done.** The TypeID, KSUID, and TSID rows\ncompare uniku returning its primary value directly against a reference that\nallocates an object first. That gap is real for callers, but it measures API shape\nas much as encoding speed."},"320":{"id":"/docs/guides/performance-68","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#how-to-read-these-numbers","content":"**The ULID row measures the reference's overhead.** `ulid@3.0.2` runs\n`detectPRNG()` — feature detection plus `detectRoot()` — on every `ulid()` call,\nthen draws its 16 random characters through 16 separate\n`getRandomValues(new Uint8Array(1))` calls, and builds the string by prepending.\nThat is a real property of that package, and it dominates the ratio."},"321":{"id":"/docs/guides/performance-69","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#how-to-read-these-numbers","content":"**Everything here is one engine.** These are Node.js numbers on V8, and several\nhot paths are unrolled for it. Bun, Deno, and browser engines are covered by the\ncorrectness matrix, not by these measurements."},"322":{"id":"/docs/guides/performance-70","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#methodology","content":"The compatibility benchmark\nruns each implementation in a fresh process, so neither side inherits the other's\nwarmed JIT state or shared buffers. CI balances both launch orders across four\nrepetitions and reports the per-row median."},"323":{"id":"/docs/guides/performance-71","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#methodology","content":"`bench-results.ts` carries the statistics:"},"324":{"id":"/docs/guides/performance-72","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#methodology","content":"dispersion uses the median absolute deviation scaled by 1.4826 rather than a\nstandard deviation, so one noisy runner does not dominate;"},"325":{"id":"/docs/guides/performance-73","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#methodology","content":"`withinActionRme` describes spread across repetitions in one CI action and\n`crossActionRme` describes spread across historical actions;"},"326":{"id":"/docs/guides/performance-74","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#methodology","content":"a regression must exceed `max(configured threshold, 2 × combined dispersion)`\nbefore it is reported, and reference-side rows never gate a change;"},"327":{"id":"/docs/guides/performance-75","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#methodology","content":"`bench-summary` prints the combined dispersion for the ratio as a `Spread`\ncolumn, and labels a row `parity (within spread)` when its deviation from 1× is\nsmaller than that spread."},"328":{"id":"/docs/guides/performance-76","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#methodology","content":"Shared-runner benchmarks stay directional. They report possible regressions\ninstead of blocking a release, and the deterministic build, type, test,\npacked-package, runtime, and bundle checks are the actual gates."},"329":{"id":"/docs/guides/performance-77","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#methodology","content":"Recorded results live in the CI run,\nand the rolling baseline\ntracks later runs."},"330":{"id":"/docs/guides/performance-78","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"Every entry point is independently importable and tree-shakeable: importing\n`uniku/ulid` does not pull in the UUID, TypeID, or KSUID code. Sizes below were\nremeasured from the current source with `tsdown@0.22.3`, minification, and gzip\nlevel 9:"},"331":{"id":"/docs/guides/performance-79","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"Import"},"332":{"id":"/docs/guides/performance-80","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"Minified + gzipped"},"333":{"id":"/docs/guides/performance-81","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/uuid/v4`"},"334":{"id":"/docs/guides/performance-82","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.2 KB"},"335":{"id":"/docs/guides/performance-83","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/uuid/v5`"},"336":{"id":"/docs/guides/performance-84","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.8 KB"},"337":{"id":"/docs/guides/performance-85","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/uuid/v7`"},"338":{"id":"/docs/guides/performance-86","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.7 KB"},"339":{"id":"/docs/guides/performance-87","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/ulid`"},"340":{"id":"/docs/guides/performance-88","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.9 KB"},"341":{"id":"/docs/guides/performance-89","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/typeid`"},"342":{"id":"/docs/guides/performance-90","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~2.9 KB"},"343":{"id":"/docs/guides/performance-91","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/cuid2`"},"344":{"id":"/docs/guides/performance-92","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.0 KB"},"345":{"id":"/docs/guides/performance-93","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/cuid/v2`"},"346":{"id":"/docs/guides/performance-94","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.0 KB"},"347":{"id":"/docs/guides/performance-95","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/nanoid`"},"348":{"id":"/docs/guides/performance-96","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.2 KB"},"349":{"id":"/docs/guides/performance-97","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/ksuid`"},"350":{"id":"/docs/guides/performance-98","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.5 KB"},"351":{"id":"/docs/guides/performance-99","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/objectid`"},"352":{"id":"/docs/guides/performance-100","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.6 KB"},"353":{"id":"/docs/guides/performance-101","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/tsid`"},"354":{"id":"/docs/guides/performance-102","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.7 KB"},"355":{"id":"/docs/guides/performance-103","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/xid`"},"356":{"id":"/docs/guides/performance-104","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~2.1 KB"},"357":{"id":"/docs/guides/performance-105","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/errors`"},"358":{"id":"/docs/guides/performance-106","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~445 B"},"359":{"id":"/docs/guides/performance-107","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/generators`"},"360":{"id":"/docs/guides/performance-108","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~101 B"},"361":{"id":"/docs/guides/performance-109","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"These numbers are reproducible byte-for-byte with `pnpm bundle:summary`."},"362":{"id":"/docs/guides/performance-110","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"The CUID v2 entry point imports SHA3-512 from `@noble/hashes`, uniku's one runtime\ndependency; the size above excludes that external dependency's own weight. The\nUUID v5 entry point inlines its SHA-1, so its size includes the whole hash and it\nhas no runtime dependency."},"363":{"id":"/docs/guides/performance-111","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#reproduce-these-numbers","content":"Run the benchmark and bundle-size tooling from the repository root:"},"364":{"id":"/docs/guides/performance-112","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#reproduce-these-numbers","content":"`bench:compat` runs uniku and the reference packages in separate processes;\n`bench:summary` reads those results and prints a comparison table. CI repeats the\ncompatibility run four times with balanced launch orders, which is what populates\nthe `Spread` column. `bundle:summary` builds each entry point and reports its\nminified, gzipped size. `bench:cold-start` measures fresh-process startup\nseparately from warmed generation throughput."},"365":{"id":"/docs","page_id":"/docs","type":"page","content":"Start here","breadcrumbs":["Docs"],"tags":[],"url":"/docs"},"366":{"id":"/docs-0","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"Eleven type-safe ID strategies behind one API, with measured performance and independent entry points."},"367":{"id":"/docs-1","page_id":"/docs","type":"heading","tags":[],"url":"/docs#the-library-contract","content":"The library contract"},"368":{"id":"/docs-2","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"uniku collects eleven ID generation strategies behind one consistent, type-safe API: UUID v4/v5/v7, ULID, TypeID, Nanoid, CUID v2, KSUID, ObjectID, XID, and TSID. Published benchmarks compare generation speed with dedicated npm alternatives for each format. Each strategy still has its own entry point, so your application ships only the code it imports."},"369":{"id":"/docs-3","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Install uniku\" href=\"/docs/getting-started\" description=\"Generate your first ID in one import.\" icon=\"<PackageOpen />\" />"},"370":{"id":"/docs-4","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Compare eleven strategies\" href=\"/docs/guides/choosing-an-id\" description=\"Choose a format by the job it needs to do.\" icon=\"<ScanLine />\" />"},"371":{"id":"/docs-5","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"See the benchmarks\" href=\"/docs/guides/performance\" description=\"Compare every generator with its dedicated npm alternative.\" icon=\"<Gauge />\" />"},"372":{"id":"/docs-6","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Browse integrations\" href=\"/docs/guides/integrations\" description=\"Start with runnable Hono, Drizzle, and Effect examples.\" icon=\"<Blocks />\" />"},"373":{"id":"/docs-7","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Use the CLI\" href=\"/docs/cli\" description=\"Generate, inspect, and validate without writing a script.\" icon=\"<Terminal />\" />"},"374":{"id":"/docs-8","page_id":"/docs","tags":[],"type":"text","url":"/docs","content":"<Card title=\"Migrate to uniku\" href=\"/docs/migration/from-other-libraries\" description=\"Move from a familiar ID package without changing stored identifiers.\" icon=\"<ArrowRightLeft />\" />"},"375":{"id":"/docs-9","page_id":"/docs","tags":[],"type":"text","url":"/docs#the-library-contract","content":"Every generator import returns a callable function with precise TypeScript signatures and the helpers that make sense for its format, such as `isValid()`, `toBytes()`, `fromBytes()`, or `timestamp()`. The library is ESM-only, built on web standards, and tested end to end across Node.js, Bun, Deno, browsers, and Cloudflare Workers. The stability contract defines the entry points, validation boundaries, and runtime support policy that take effect with `uniku@1.0.0`."},"376":{"id":"/docs-10","page_id":"/docs","tags":[],"type":"text","url":"/docs#the-library-contract","content":"Install @uniku/cli when you need an ID in a terminal, migration, or shell pipeline. It shares the library's formats but has its own release lifecycle."},"377":{"id":"/docs/migration/from-other-libraries","page_id":"/docs/migration/from-other-libraries","type":"page","content":"Migrate from other libraries","breadcrumbs":["Docs","Migration"],"tags":[],"url":"/docs/migration/from-other-libraries"},"378":{"id":"/docs/migration/from-other-libraries-0","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries","content":"Keep familiar formats while moving to direct, portable imports."},"379":{"id":"/docs/migration/from-other-libraries-1","page_id":"/docs/migration/from-other-libraries","type":"heading","tags":[],"url":"/docs/migration/from-other-libraries#from-uuid","content":"From `uuid`"},"380":{"id":"/docs/migration/from-other-libraries-2","page_id":"/docs/migration/from-other-libraries","type":"heading","tags":[],"url":"/docs/migration/from-other-libraries#name-based-uuid-v5","content":"Name-based UUID v5"},"381":{"id":"/docs/migration/from-other-libraries-3","page_id":"/docs/migration/from-other-libraries","type":"heading","tags":[],"url":"/docs/migration/from-other-libraries#from-nanoid","content":"From `nanoid`"},"382":{"id":"/docs/migration/from-other-libraries-4","page_id":"/docs/migration/from-other-libraries","type":"heading","tags":[],"url":"/docs/migration/from-other-libraries#from-ulid","content":"From `ulid`"},"383":{"id":"/docs/migration/from-other-libraries-5","page_id":"/docs/migration/from-other-libraries","type":"heading","tags":[],"url":"/docs/migration/from-other-libraries#from-typeid-js","content":"From `typeid-js`"},"384":{"id":"/docs/migration/from-other-libraries-6","page_id":"/docs/migration/from-other-libraries","type":"heading","tags":[],"url":"/docs/migration/from-other-libraries#from-paralleldrivecuid2","content":"From `@paralleldrive/cuid2`"},"385":{"id":"/docs/migration/from-other-libraries-7","page_id":"/docs/migration/from-other-libraries","type":"heading","tags":[],"url":"/docs/migration/from-other-libraries#from-owpzksuid","content":"From `@owpz/ksuid`"},"386":{"id":"/docs/migration/from-other-libraries-8","page_id":"/docs/migration/from-other-libraries","type":"heading","tags":[],"url":"/docs/migration/from-other-libraries#from-bson","content":"From `bson`"},"387":{"id":"/docs/migration/from-other-libraries-9","page_id":"/docs/migration/from-other-libraries","type":"heading","tags":[],"url":"/docs/migration/from-other-libraries#from-tsid-ts","content":"From `tsid-ts`"},"388":{"id":"/docs/migration/from-other-libraries-10","page_id":"/docs/migration/from-other-libraries","type":"heading","tags":[],"url":"/docs/migration/from-other-libraries#from-xid-ts-or-nexid","content":"From `xid-ts` or `nexid`"},"389":{"id":"/docs/migration/from-other-libraries-11","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries","content":"Migration is usually an import change first. Keep the stored identifier format stable, then move generation behind the new direct entry point. Every example below shows the value returned by the uniku generator."},"390":{"id":"/docs/migration/from-other-libraries-12","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-uuid","content":"uniku generates UUID v4, v5, and v7. There is no uniku equivalent for v1, v3, or v6; keep the `uuid` package for those, or generate them elsewhere and only use uniku for v4, v5, and v7 values."},"391":{"id":"/docs/migration/from-other-libraries-13","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-uuid","content":"The rest of `uuid`'s API maps onto uniku's per-generator methods, scoped to the version you imported:"},"392":{"id":"/docs/migration/from-other-libraries-14","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-uuid","content":"`uuid`"},"393":{"id":"/docs/migration/from-other-libraries-15","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-uuid","content":"uniku"},"394":{"id":"/docs/migration/from-other-libraries-16","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-uuid","content":"`parse(id)`"},"395":{"id":"/docs/migration/from-other-libraries-17","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-uuid","content":"`uuidv4.toBytes(id)` / `uuidv5.toBytes(id)` / `uuidv7.toBytes(id)`, like `parse()`, accept any 128-bit UUID form regardless of version"},"396":{"id":"/docs/migration/from-other-libraries-18","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-uuid","content":"`stringify(bytes)`"},"397":{"id":"/docs/migration/from-other-libraries-19","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-uuid","content":"`uuidv4.fromBytes(bytes)` / `uuidv5.fromBytes(bytes)` / `uuidv7.fromBytes(bytes)`"},"398":{"id":"/docs/migration/from-other-libraries-20","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-uuid","content":"`validate(id)`"},"399":{"id":"/docs/migration/from-other-libraries-21","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-uuid","content":"`uuidv4.isValid(id)` / `uuidv5.isValid(id)` / `uuidv7.isValid(id)`"},"400":{"id":"/docs/migration/from-other-libraries-22","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-uuid","content":"`version(id)`"},"401":{"id":"/docs/migration/from-other-libraries-23","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-uuid","content":"Implied by which `isValid` matches: each accepts only its own version."},"402":{"id":"/docs/migration/from-other-libraries-24","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#name-based-uuid-v5","content":"`uuid`'s `v5(name, namespace)` becomes `uuidv5(name, namespace)`, with the same argument order. The buffer form `v5(name, namespace, buf, offset)` keeps its order too. Both produce the same IDs for the same inputs, so stored v5 values stay valid."},"403":{"id":"/docs/migration/from-other-libraries-25","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#name-based-uuid-v5","content":"`uuid`"},"404":{"id":"/docs/migration/from-other-libraries-26","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#name-based-uuid-v5","content":"uniku"},"405":{"id":"/docs/migration/from-other-libraries-27","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#name-based-uuid-v5","content":"`v5(name, namespace)`"},"406":{"id":"/docs/migration/from-other-libraries-28","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#name-based-uuid-v5","content":"`uuidv5(name, namespace)`"},"407":{"id":"/docs/migration/from-other-libraries-29","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#name-based-uuid-v5","content":"`v5(name, namespace, buf, offset)`"},"408":{"id":"/docs/migration/from-other-libraries-30","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#name-based-uuid-v5","content":"`uuidv5(name, namespace, buf, offset)`"},"409":{"id":"/docs/migration/from-other-libraries-31","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#name-based-uuid-v5","content":"`v5.DNS` / `v5.URL`"},"410":{"id":"/docs/migration/from-other-libraries-32","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#name-based-uuid-v5","content":"`uuidv5.DNS` / `uuidv5.URL`"},"411":{"id":"/docs/migration/from-other-libraries-33","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#name-based-uuid-v5","content":"uniku also exposes `uuidv5.OID` and `uuidv5.X500`, and `uuidv5.namespace(ns)` to parse a namespace once for many names. See UUID v5."},"412":{"id":"/docs/migration/from-other-libraries-34","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-typeid-js","content":"`typeid-js` returns a TypeID object. uniku returns the canonical string directly."},"413":{"id":"/docs/migration/from-other-libraries-35","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-tsid-ts","content":"`tsid-ts` exposes a TSID object. uniku uses the native `bigint` as TSID's primary value."},"414":{"id":"/docs/migration/from-other-libraries-36","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-tsid-ts","content":"Convert at a string boundary when you need the canonical Base32 form:"},"415":{"id":"/docs/migration/from-other-libraries-37","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-xid-ts-or-nexid","content":"Both libraries implement the rs/xid representation. uniku returns the canonical string directly and does not require asynchronous setup."},"416":{"id":"/docs/migration/from-other-libraries-38","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-xid-ts-or-nexid","content":"Use `xid.toBytes(id)` and `xid.fromBytes(bytes)` when you store the 12-byte value."},"417":{"id":"/docs/migration/from-other-libraries-39","page_id":"/docs/migration/from-other-libraries","tags":[],"type":"text","url":"/docs/migration/from-other-libraries#from-xid-ts-or-nexid","content":"Before replacing an existing generator, test the representation you store and expose. UUIDs, ULIDs, ObjectIDs, and XIDs have canonical byte forms; Nanoid and CUID v2 are string-native."},"418":{"id":"/docs/migration/v1","page_id":"/docs/migration/v1","type":"page","content":"Migrate to uniku v1","breadcrumbs":["Docs","Migration"],"tags":[],"url":"/docs/migration/v1"},"419":{"id":"/docs/migration/v1-0","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1","content":"Prepare for the v1 entry-point contract without changing identifier data."},"420":{"id":"/docs/migration/v1-1","page_id":"/docs/migration/v1","type":"heading","tags":[],"url":"/docs/migration/v1#move-cuid-v2-to-the-versioned-entry-point","content":"Move CUID v2 to the versioned entry point"},"421":{"id":"/docs/migration/v1-2","page_id":"/docs/migration/v1","type":"heading","tags":[],"url":"/docs/migration/v1#update-error-code-matches","content":"Update error-code matches"},"422":{"id":"/docs/migration/v1-3","page_id":"/docs/migration/v1","type":"heading","tags":[],"url":"/docs/migration/v1#removed-codes","content":"Removed codes"},"423":{"id":"/docs/migration/v1-4","page_id":"/docs/migration/v1","type":"heading","tags":[],"url":"/docs/migration/v1#what-remains-stable","content":"What remains stable"},"424":{"id":"/docs/migration/v1-5","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1","content":"uniku v1 keeps its canonical identifier formats stable while finalizing its pre-v1 entry points and machine-readable error contract."},"425":{"id":"/docs/migration/v1-6","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#move-cuid-v2-to-the-versioned-entry-point","content":"`uniku/cuid2` is a pre-v1 alias. Use the canonical versioned import before upgrading:"},"426":{"id":"/docs/migration/v1-7","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#move-cuid-v2-to-the-versioned-entry-point","content":"The generator behavior is the same. This is an import migration, not a data migration: existing CUID v2 values remain valid."},"427":{"id":"/docs/migration/v1-8","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"Pre-v1 error codes included the generator name. V1 uses strategy-agnostic codes and reports the generator separately through `error.strategy`:"},"428":{"id":"/docs/migration/v1-9","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`uniku/errors` exports `ERROR_CODES`, the authoritative runtime catalog, and its derived `ErrorCode` type. The `_tag` classes and human-readable messages keep their existing roles."},"429":{"id":"/docs/migration/v1-10","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"This table maps every machine-readable code emitted by `uniku@0.4.3` to its v1 replacement:"},"430":{"id":"/docs/migration/v1-11","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"Pre-v1 code(s)"},"431":{"id":"/docs/migration/v1-12","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"V1 code"},"432":{"id":"/docs/migration/v1-13","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`UUID_TIMESTAMP_OUT_OF_RANGE`, `ULID_TIMESTAMP_OUT_OF_RANGE`, `ULID_TIMESTAMP_OVERFLOW`, `KSUID_TIMESTAMP_TOO_LOW`, `KSUID_TIMESTAMP_TOO_HIGH`, `OBJECTID_TIMESTAMP_OUT_OF_RANGE`, `XID_TIMESTAMP_OUT_OF_RANGE`, `TSID_TIMESTAMP_INVALID`, `TSID_TIMESTAMP_OUT_OF_RANGE`"},"433":{"id":"/docs/migration/v1-14","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`TIMESTAMP_OUT_OF_RANGE`"},"434":{"id":"/docs/migration/v1-15","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update