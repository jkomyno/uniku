ration/v1-43","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`TYPEID_PREFIX_TOO_LONG`"},"463":{"id":"/docs/migration/v1-44","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`PREFIX_TOO_LONG`"},"464":{"id":"/docs/migration/v1-45","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`TYPEID_PREFIX_INVALID_CHARACTER`"},"465":{"id":"/docs/migration/v1-46","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`PREFIX_INVALID_CHAR`"},"466":{"id":"/docs/migration/v1-47","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`TYPEID_PREFIX_INVALID_BOUNDARY`"},"467":{"id":"/docs/migration/v1-48","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`PREFIX_INVALID_BOUNDARY`"},"468":{"id":"/docs/migration/v1-49","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`TYPEID_UUID_NOT_V7`"},"469":{"id":"/docs/migration/v1-50","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`UUID_NOT_V7`"},"470":{"id":"/docs/migration/v1-51","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`NANOID_ALPHABET_TOO_SHORT`, `NANOID_ALPHABET_TOO_LONG`"},"471":{"id":"/docs/migration/v1-52","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`ALPHABET_OUT_OF_RANGE`"},"472":{"id":"/docs/migration/v1-53","page_id":"/docs/migration/v1","tags":[],"type":"text","url":"/docs/migration/v1#update-error-code-matches","content":"`NANOID_ALPHABET_INVALID