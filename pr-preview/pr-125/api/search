:{"id":"/docs/cli-103","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#inspect","content":"An explicit `--type` still validates the ID. Malformed input exits with code 1,\nleaves stdout empty, and writes the error to stderr. With `--json`, that error\nis a JSON object with an `error` message and a `code` such as `INVALID_ID`."},"106":{"id":"/docs/cli-104","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#inspect","content":"Option"},"107":{"id":"/docs/cli-105","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#inspect","content":"Description"},"108":{"id":"/docs/cli-106","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#inspect","content":"`--type`"},"109":{"id":"/docs/cli-107","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#inspect","content":"ID type: `uuid`, `ulid`, `typeid`, `nanoid`, `cuid`, `ksuid`, `objectid`, `xid`, `tsid` (auto-detected if omitted)"},"110":{"id":"/docs/cli-108","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#inspect","content":"`--json`"},"111":{"id":"/docs/cli-109","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#inspect","content":"Output as JSON"},"112":{"id":"/docs/cli-110","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#validate","content":"Check whether an ID is well-formed, one at a time or in bulk from stdin."},"113":{"id":"/docs/cli-111","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#validate","content":"Option"},"114":{"id":"/docs/cli-112","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#validate","content":"Description"},"115":{"id":"/docs/cli-113","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#validate","content":"`--type`"},"116":{"id":"/docs/cli-114","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#validate","content":"Expected ID type (auto-detected if omitted)"},"117":{"id":"/docs/cli-115","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#validate","content":"`--stdin`"},"118":{"id":"/docs/cli-116","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#validate","content":"Read IDs from stdin (one per line)"},"119":{"id":"/docs/cli-117","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#validate","content":"`--quiet`"},"120":{"id":"/docs/cli-118","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#validate","content":"No output, exit code only (`0` valid, `2` invalid)"},"121":{"id":"/docs/cli-119","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#validate","content":"`--json`"},"122":{"id":"/docs/cli-120","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#validate","content":"Output as JSON"},"123":{"id":"/docs/cli-121","page_id":"/docs/cli","tags":[],"type":"text","url":"/docs/cli#validate","content":"Use `--json` whenever the output feeds another program. The CLI and library publish independently: a library `1.0.0` release does not imply a CLI `1.0.0` release at the same time."},"124":{"id":"/docs/getting-started","page_id":"/docs/getting-started","type":"page","content":"Getting started","breadcrumbs":["Docs"],"tags":[],"url":"/docs/getting-started"},"125":{"id":"/docs/getting-started-0","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Install eleven type-safe ID strategies, then import only the generator your application needs."},"126":{"id":"/docs/getting-started-1","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#install","content":"Install"},"127":{"id":"/docs/getting-started-2","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#the-usual-shape","content":"The usual shape"},"128":{"id":"/docs/getting-started-3","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#every-strategy","content":"Every strategy"},"129":{"id":"/docs/getting-started-4","page_id":"/docs/getting-started","