ent":"`typeid`, `ksuid`, `tsid`"},"653":{"id":"/docs/reference/errors-127","page_id":"/docs/reference/errors","tags":[],"type":"text","url":"/docs/reference/errors#error-code-catalog","content":"A parsed or supplied value exceeds the format's numeric range."},"654":{"id":"/docs/reference/errors-128","page_id":"/docs/reference/errors","tags":[],"type":"text","url":"/docs/reference/errors#error-code-catalog","content":"The same code can be used by more than one error class when the failure meaning is identical. For example, `TIMESTAMP_OUT_OF_RANGE` can describe an invalid generation option or an overflow discovered while parsing."},"655":{"id":"/docs/reference/errors-129","page_id":"/docs/reference/errors","tags":[],"type":"text","url":"/docs/reference/errors#generator-list","content":"`uniku/generators` exports the canonical, ordered list of ID kinds uniku supports:"},"656":{"id":"/docs/reference/errors-130","page_id":"/docs/reference/errors","tags":[],"type":"text","url":"/docs/reference/errors#generator-list","content":"`IdGenerator` is the union type derived from `ID_GENERATORS`. Tools that enumerate or validate generator kinds, such as `@uniku/cli`'s `--type` flag, should derive from this array instead of hand-copying the union."},"657":{"id":"/docs/reference/ksuid","page_id":"/docs/reference/ksuid","type":"page","content":"KSUID","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/ksuid"},"658":{"id":"/docs/reference/ksuid-0","page_id":"/docs/reference/ksuid","tags":[],"type":"text","url":"/docs/reference/ksuid","content":"Time-ordered identifiers with a 128-bit random payload."},"659":{"id":"/docs/reference/ksuid-1","page_id":"/docs/reference/ksuid","tags":[],"type":"text","url":"/docs/reference/ksuid","content":"KSUID combines a timestamp with a large random payload. Choose it for high-volume distributed systems that need chronological order and a 27-character URL-safe string."},"660":{"id":"/docs/reference/nanoid","page_id":"/docs/reference/nanoid","type":"page","content":"Nanoid","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/nanoid"},"661":{"id":"/docs/reference/nanoid-0","page_id":"/docs/reference/nanoid","tags":[],"type":"text","url":"/docs/reference/nanoid","content":"Compact, URL-safe random strings with configurable length and alphabet."},"662":{"id":"/docs/reference/nanoid-1","page_id":"/docs/reference/nanoid","tags":[],"type":"text","url":"/docs/reference/nanoid","content":"Nanoid is the compact choice for short URLs, invite codes, and session tokens. Its default alphabet is URL-safe; pass a length or options only when the boundary needs a different shape."},"663":{"id":"/docs/reference/nanoid-2","page_id":"/docs/reference/nanoid","tags":[],"type":"text","url":"/docs/reference/nanoid","content":"`nanoid.isValid()` only checks that a value is a non-empty run of the default URL-safe alphabet. A nanoid carries neither a length nor an alphabet, so it cannot verify either: any length is accepted, and an ID built from a custom alphabet passes whenever that alphabet is a subset of the default one — a hex-only alphabet, for example. Compare `id.length` yourself when the boundary needs one size."},"664":{"id":"/docs/reference/objectid","page_id":"/docs/reference/objectid","type":"page","content":"ObjectID","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/objectid"},"665":{"id":"/docs/reference/objectid-0","page_id":"/docs/reference/objectid","tags":[],"type":"text","url":"/docs/reference/objectid","content":"MongoDB-compatible 12-byte identifiers."},"666":{"id":"/docs/reference/objectid-1","page_id":"/docs/reference/objectid","tags":[],"type":"text","url":"/docs/reference/objectid","content":"ObjectID matches MongoDB's native 12-byte representation. Use it when your application stores `_id` values alongside MongoDB clients or needs to preserve that wire format."},"667":{"id":"/docs/reference/tsid","page_id":"/docs/reference/tsid","type":"page","content":"TSID","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/tsid"},"668":{"id":"/docs/reference/tsid-0","page_id":"/docs/reference/tsid","tags":[],"type":"text","url":"/docs/reference/tsid","content":"Time-sorted 64-bit identifiers for native bigint storage."},"669":{"id":"/docs/reference/tsid-1","page_id":"/docs/reference/tsid","tags":[],"type":"text","url":"/docs/reference/tsid","content":"TSID returns a `bigint`, not a string. Use it when a database `BIGINT` primary key is the natural representation and you still need time ordering without a central allocator."},"670":{"id":"/docs/reference/tsid-2","page_id":"/docs/reference/tsid","tags":[],"type":"text","url":"/docs/reference/tsid","content":"Setting `node`, `nodeBits`, or `epoch` keeps stateful generation: repeated calls\nwith the same configuration advance the counter, handle clock rollback, and\nadvance virtual time when the counter fills. Calls share the isolate's sequence."},"671":{"id":"/docs/reference/tsid-3","page_id":"/docs/reference/tsid","tags":[],"type":"text","url":"/docs/reference/tsid","content":"An explicit `msecs` or `counter` bypasses that sequence. For repeated generation\nat a fixed timestamp, supply distinct counters and advance the timestamp on\ncounter overflow. Separate processes must coordinate node IDs themselves."},"672":{"id":"/docs/reference/typeid","page_id":"/docs/reference/typeid","type":"page","content":"TypeID","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/typeid"},"673":{"id":"/docs/reference/typeid-0","page_id":"/docs/reference/typeid","tags":[],"type":"text","url":"/docs/reference/typeid","content":"UUID identifiers with a readable, domain-specific prefix, generated as UUID v7."},"674":{"id":"/docs/reference/typeid-1","page_id":"/docs/reference/typeid","type":"heading","tags":[],"url":"/docs/reference/typeid#wrapping-an-existing-uuid","content":"Wrapping an existing UUID"},"675":{"id":"/docs/reference/typeid-2","page_id":"/docs/reference/typeid","type":"heading","tags":[],"url":"/docs/reference/typeid#timestamps","content":"Timestamps"},"676":{"id":"/docs/reference/typeid-3","page_id":"/docs/reference/typeid","tags":[],"type":"text","url":"/docs/reference/typeid","content":"TypeID puts a lowercase prefix such as `user_` or `order_` in front of a base32-encoded UUID. It is useful when a public identifier should reveal the kind of resource it identifies. `typeid()` always generates a UUID v7, so new TypeIDs sort by creation time."},"677":{"id":"/docs/reference/typeid-4","page_id":"/docs/reference/typeid","tags":[],"type":"text","url":"/docs/reference/typeid#wrapping-an-existing-uuid","content":"`typeid.fromUuid()` and `typeid.fromBytes()` accept a UUID of any version, as the TypeID specification recommends. So do `toUuid()`, `toBytes()`, `prefix()`, `suffix()`, and `isValid()`. Wrapping a name-based UUID v5 gives a TypeID that is the same every time you derive it."},"678":{"id":"/docs/reference/typeid-5","page_id":"/docs/reference/typeid","tags":[],"type":"text","url":"/docs/reference/typeid#wrapping-an-existing-uuid","content":"A string that is not a UUID throws a `ParseError` with code `INVALID_LENGTH`, `INVALID_FORMAT`, or `INVALID_CHAR`."},"679":{"id":"/docs/reference/typeid-6","page_id":"/docs/reference/typeid","tags":[],"type":"text","url":"/docs/reference/typeid#timestamps","content":"`typeid.timestamp()` reads the creation time from a TypeID that wraps a UUID v7, in milliseconds. For any other UUID it throws an `InvalidInputError` with code `UUID_NOT_V7`, because those bits are not a time."},"680":{"id":"/docs/reference/ulid","page_id":"/docs/reference/ulid","type":"page","content":"ULID","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/ulid"},"681":{"id":"/docs/reference/ulid-0","page_id":"/docs/reference/ulid","tags":[],"type":"text","url":"/docs/reference/ulid","content":"Sortable, URL-safe identifiers using Crockford Base32."},"682":{"id":"/docs/reference/ulid-1","page_id":"/docs/reference/ulid","tags":[],"type":"text","url":"/docs/reference/ulid","content":"ULIDs sort by creation time and stay shorter than a hyphenated UUID. Use them when the value will often appear in URLs, logs, or APIs."},"683":{"id":"/docs/reference/uuid-v4","page_id":"/docs/reference/uuid-v4","type":"page","content":"UUID v4","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/uuid-v4"},"684":{"id":"/docs/reference/uuid-v4-0","page_id":"/docs/reference/uuid-v4","tags":[],"type":"text","url":"/docs/reference/uuid-v4","content":"Random, standards-compatible UUIDs with 122 bits of entropy."},"685":{"id":"/docs/reference/uuid-v4-1","page_id":"/docs/reference/uuid-v4","tags":[],"type":"text","url":"/docs/reference/uuid-v4","content":"UUID v4 is the default when compatibility matters more than sort order. It fits databases and APIs that already understand UUID strings."},"686":{"id":"/docs/reference/uuid-v4-2","page_id":"/docs/reference/uuid-v4","tags":[],"type":"text","url":"/docs/reference/uuid-v4","content":"Use `toBytes()` when the destination stores UUIDs as 16-byte binary values. Use `isValid()` before accepting an unknown UUID v4 string at an application boundary."},"687":{"id":"/docs/reference/uuid-v4-3","page_id":"/docs/reference/uuid-v4","tags":[],"type":"text","url":"/docs/reference/uuid-v4","content":"Random values make a poor clustered primary key, because every insert lands at a random position in the index. Storing IDs in a database covers the alternatives."},"688":{"id":"/docs/reference/uuid-v5","page_id":"/docs/reference/uuid-v5","type":"page","content":"UUID v5","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/uuid-v5"},"689":{"id":"/docs/reference/uuid-v5-0","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5","content":"Name-based UUIDs derived from a namespace and a name, with no state to keep."},"690":{"id":"/docs/reference/uuid-v5-1","page_id":"/docs/reference/uuid-v5","type":"heading","tags":[],"url":"/docs/reference/uuid-v5#derive-many-ids-in-one-namespace","content":"Derive many IDs in one namespace"},"691":{"id":"/docs/reference/uuid-v5-2","page_id":"/docs/reference/uuid-v5","type":"heading","tags":[],"url":"/docs/reference/uuid-v5#choose-a-namespace","content":"Choose a namespace"},"692":{"id":"/docs/reference/uuid-v5-3","page_id":"/docs/reference/uuid-v5","type":"heading","tags":[],"url":"/docs/reference/uuid-v5#compose-inputs-by-chaining-namespaces","content":"Compose inputs by chaining namespaces"},"693":{"id":"/docs/reference/uuid-v5-4","page_id":"/docs/reference/uuid-v5","type":"heading","tags":[],"url":"/docs/reference/uuid-v5#strings-are-hashed-as-utf-8-without-normalization","content":"Strings are hashed as UTF-8, without normalization"},"694":{"id":"/docs/reference/uuid-v5-5","page_id":"/docs/reference/uuid-v5","type":"heading","tags":[],"url":"/docs/reference/uuid-v5#an-identifier-not-a-secret","content":"An identifier, not a secret"},"695":{"id":"/docs/reference/uuid-v5-6","page_id":"/docs/reference/uuid-v5","type":"heading","tags":[],"url":"/docs/reference/uuid-v5#no-timestamp","content":"No timestamp"},"696":{"id":"/docs/reference/uuid-v5-7","page_id":"/docs/reference/uuid-v5","type":"heading","tags":[],"url":"/docs/reference/uuid-v5#why-not-memoize-a-random-id","content":"Why not memoize a random ID"},"697":{"id":"/docs/reference/uuid-v5-8","page_id":"/docs/reference/uuid-v5","type":"heading","tags":[],"url":"/docs/reference/uuid-v5#adding-a-typeid-prefix","content":"Adding a TypeID prefix"},"698":{"id":"/docs/reference/uuid-v5-9","page_id":"/docs/reference/uuid-v5","type":"heading","tags":[],"url":"/docs/reference/uuid-v5#errors","content":"Errors"},"699":{"id":"/docs/reference/uuid-v5-10","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5","content":"UUID v5 derives an ID from something you already have. It hashes a namespace and a name with SHA-1 (RFC 9562, section 5.5), so the same inputs give the same ID in every process, on every runtime, a year later. Use it when you receive an identifier from a system you do not control and want your own stable ID for it."},"700":{"id":"/docs/reference/uuid-v5-11","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5","content":"The arguments are `(name, namespace)`, in the same order as the `uuid` package. Both accept a string or a `Uint8Array`. Like every uniku generator, `uuidv5()` is synchronous: the SHA-1 implementation is small and inlined, so the entry point has no runtime dependency and imports no other generator."},"701":{"id":"/docs/reference/uuid-v5-12","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#derive-many-ids-in-one-namespace","content":"Most callers use one namespace for many names. `uuidv5.namespace()` validates and parses the namespace once and returns a function that takes only the name:"},"702":{"id":"/docs/reference/uuid-v5-13","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#derive-many-ids-in-one-namespace","content":"The bound function holds the namespace, not past results. It copies namespace bytes, so changing your array afterwards does not change the IDs it derives."},"703":{"id":"/docs/reference/uuid-v5-14","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#choose-a-namespace","content":"`uuidv5.DNS`, `uuidv5.URL`, `uuidv5.OID`, and `uuidv5.X500` are the RFC 9562 namespaces for domain names, URLs, ISO object identifiers, and X.500 distinguished names. Use them only for names of that kind."},"704":{"id":"/docs/reference/uuid-v5-15","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#choose-a-namespace","content":"For application names, pick your own namespace. Generate one UUID once, for example with `uuidv4()`, hard-code it, and never change it. A different namespace gives different IDs for every name."},"705":{"id":"/docs/reference/uuid-v5-16","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#compose-inputs-by-chaining-namespaces","content":"Do not concatenate parts into one name. `'a' + 'bc'` and `'ab' + 'c'` give the same name, so they give the same ID. Derive a namespace for the outer part instead, and use it for the inner part:"},"706":{"id":"/docs/reference/uuid-v5-17","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#strings-are-hashed-as-utf-8-without-normalization","content":"A string name is encoded as UTF-8 and hashed as is. uniku does not apply Unicode normalization, which matches other implementations. `'é'` written as one code point (NFC) and as `e` plus a combining accent (NFD) gives two different IDs. If your inputs can arrive in either form, normalize them first:"},"707":{"id":"/docs/reference/uuid-v5-18","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#strings-are-hashed-as-utf-8-without-normalization","content":"A string with a lone surrogate is not valid Unicode. UTF-8 encoding replaces each one with U+FFFD, so `'a\\uD800b'` and `'a\\uFFFDb'` give the same ID. The `uuid` package throws for these strings instead. If your names can contain arbitrary UTF-16, check them first with `String.prototype.isWellFormed()` where your runtime supports it."},"708":{"id":"/docs/reference/uuid-v5-19","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#an-identifier-not-a-secret","content":"A UUID v5 does not reveal its name. It is still not a secret: anyone who knows or can guess the name and namespace can compute the same ID. Do not use it as a token, and do not derive it from data that must stay private when the possible inputs are few or known."},"709":{"id":"/docs/reference/uuid-v5-20","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#an-identifier-not-a-secret","content":"SHA-1 is fine for identity. It is not a security boundary: someone who controls the names can craft two that collide. uniku has no SHA-256 or UUID v8 variant. If names come from an untrusted party and a collision would matter, do not rely on the ID alone."},"710":{"id":"/docs/reference/uuid-v5-21","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#no-timestamp","content":"A UUID v5 carries no time, so there is no `timestamp()` helper, as on UUID v4. IDs derived from different names have no useful order."},"711":{"id":"/docs/reference/uuid-v5-22","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#why-not-memoize-a-random-id","content":"A `Map` from input to `uuidv7()` gives a stable ID only while the map lives. Another process, machine, or restart mints a different ID unless you add a shared, durable store, and two writers racing on first use can mint two IDs. A derived ID needs no store and cannot disagree: the function is the table."},"712":{"id":"/docs/reference/uuid-v5-23","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#why-not-memoize-a-random-id","content":"uniku keeps no cache. If a hot loop derives the same names repeatedly, cache the results in your own code, with a size bound you choose."},"713":{"id":"/docs/reference/uuid-v5-24","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#adding-a-typeid-prefix","content":"`typeid.fromUuid()` wraps a UUID v5, so a derived ID can carry a readable prefix and stay deterministic:"},"714":{"id":"/docs/reference/uuid-v5-25","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#adding-a-typeid-prefix","content":"Such a TypeID has no timestamp: `typeid.timestamp()` throws an `InvalidInputError` with code `UUID_NOT_V7`."},"715":{"id":"/docs/reference/uuid-v5-26","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#errors","content":"A malformed namespace string throws a `ParseError` with code `INVALID_LENGTH`, `INVALID_FORMAT`, or `INVALID_CHAR`."},"716":{"id":"/docs/reference/uuid-v5-27","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#errors","content":"A namespace `Uint8Array` that is not exactly 16 bytes throws an `InvalidInputError` with code `BYTES_INVALID_LENGTH`."},"717":{"id":"/docs/reference/uuid-v5-28","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#errors","content":"A buffer offset that cannot hold 16 bytes throws a `BufferError` with code `BUFFER_OUT_OF_BOUNDS`."},"718":{"id":"/docs/reference/uuid-v5-29","page_id":"/docs/reference/uuid-v5","tags":[],"type":"text","url":"/docs/reference/uuid-v5#errors","content":"All three use strategy `'uuid'`. See Errors for the full catalog."},"719":{"id":"/docs/reference/uuid-v7","page_id":"/docs/reference/uuid-v7","type":"page","content":"UUID v7","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/uuid-v7"},"720":{"id":"/docs/reference/uuid-v7-0","page_id":"/docs/reference/uuid-v7","tags":[],"type":"text","url":"/docs/reference/uuid-v7","content":"Time-ordered UUIDs for primary keys, APIs, and event streams."},"721":{"id":"/docs/reference/uuid-v7-1","page_id":"/docs/reference/uuid-v7","tags":[],"type":"text","url":"/docs/reference/uuid-v7","content":"UUID v7 keeps the UUID shape while embedding a millisecond timestamp. It is a strong default for database primary keys when you want chronological locality without creating a custom ID column."},"722":{"id":"/docs/reference/uuid-v7-2","page_id":"/docs/reference/uuid-v7","tags":[],"type":"text","url":"/docs/reference/uuid-v7","content":"In MySQL, store it in a `BINARY(16)` column and leave out the `UUID_TO_BIN` swap flag. Storing IDs in a database explains why."},"723":{"id":"/docs/reference/xid","page_id":"/docs/reference/xid","type":"page","content":"XID","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/xid"},"724":{"id":"/docs/reference/xid-0","page_id":"/docs/reference/xid","tags":[],"type":"text","url":"/docs/reference/xid","content":"Compact, time-ordered identifiers compatible with rs/xid."},"725":{"id":"/docs/reference/xid-1","page_id":"/docs/reference/xid","tags":[],"type":"text","url":"/docs/reference/xid","content":"XID is a 12-byte, lowercase base32hex identifier: a seconds-precision timestamp, a 40-bit per-runtime identity, and a shared 24-bit counter. Use it when you need Go's rs/xid wire format in a synchronous JavaScript runtime."},"726":{"id":"/docs/reference/xid-2","page_id":"/docs/reference/xid","tags":[],"type":"text","url":"/docs/reference/xid","content":"The default identity is random and cached for this runtime. Supplying `machineId` or `processId` changes only that field; calls still use the shared counter unless you also supply `counter`. Supply all four fields for deterministic output."},"727":{"id":"/docs/reference/xid-3","page_id":"/docs/reference/xid","tags":[],"type":"text","url":"/docs/reference/xid","content":"Independent runtimes choose their identity randomly, so uniqueness across them remains probabilistic rather than host-anchored as in Go's `rs/xid` implementation."}},"count":727},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":385,"2":464,"3":487,"4":453,"5":682,"6":654,"7":648,"8":519,"9":392,"10":494,"11":533,"12":720,"13":639,"14":486,"15":710,"16":71,"17":491,"18":346,"19":328,"20":615,"21":442,"22":432,"23":539,"24":348,"25":402,"26":36,"27":63,"28":532,"29":37,"30":551,"31":436,"32":462,"33":540,"34":349,"35":403,"36":59,"37":65,"38":707,"39":45,"40":516,"41":46,"42":698,"43":42,"44":554,"45":697,"46":461,"47":541,"48":404,"49":44,"50":457,"5