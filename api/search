ed-57","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#why-byte-helpers-exist","content":"This matters when an ID lives in a binary database column, a compact protocol payload, or a cache key. A UUID, for instance, is 16 bytes instead of its 36-character string form. The helpers also make the string boundary explicit: convert when data leaves your application, preserve bytes where the system already handles bytes."},"177":{"id":"/docs/getting-started-58","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#why-byte-helpers-exist","content":"String-native formats do not pretend otherwise. Nanoid and CUID v2 have no canonical byte encoding, so they expose a smaller API."},"178":{"id":"/docs/getting-started-59","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#write-into-a-caller-owned-buffer","content":"Binary formats can also write directly into a buffer when an integration already owns the allocation:"},"179":{"id":"/docs/getting-started-60","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#write-into-a-caller-owned-buffer","content":"Public inputs are validated. Explicit random bytes and buffer offsets make tests and boundary integrations deterministic without changing the generator's default monotonic state."},"180":{"id":"/docs/guides/choosing-an-id","page_id":"/docs/guides/choosing-an-id","type":"page","content":"Choosing an ID","breadcrumbs":["Docs","Guides"],"tags":[],"url":"/docs/guides/choosing-an-id"},"181":{"id":"/docs/guides/choosing-an-id-0","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Choose for the system boundary, not the trend."},"182":{"id":"/docs/guides/choosing-an-id-1","page_id":"/docs/guides/choosing-an-id","type":"heading","tags":[],"url":"/docs/guides/choosing-an-id#a-good-default","content":"A good default"},"183":{"id":"/docs/guides/choosing-an-id-2","page_id":"/docs/guides/choosing-an-id","type":"heading","tags":[],"url":"/docs/guides/choosing-an-id#time-ordering-is-local","content":"Time ordering is local"},"184":{"id":"/docs/guides/choosing-an-id-3","page_id":"/docs/guides/choosing-an-id","type":"heading","tags":[],"url":"/docs/guides/choosing-an-id#time-order-leaks-creation-time","content":"Time order leaks creation time"},"185":{"id":"/docs/guides/choosing-an-id-4","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Different identifiers optimize for different constraints. Start with the boundary the value crosses: database index, URL, public API, MongoDB collection, or a native integer column."},"186":{"id":"/docs/guides/choosing-an-id-5","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Situation"},"187":{"id":"/docs/guides/choosing-an-id-6","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Choose"},"188":{"id":"/docs/guides/choosing-an-id-7","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Why"},"189":{"id":"/docs/guides/choosing-an-id-8","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Database primary keys"},"190":{"id":"/docs/guides/choosing-an-id-9","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"UUID v7 or ULID"},"191":{"id":"/docs/guides/choosing-an-id-10","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Time-ordered values improve index locality."},"192":{"id":"/docs/guides/choosing-an-id-11","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Public API resources"},"193":{"id":"/docs/guides/choosing-an-id-12","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"TypeID"},"194":{"id":"/docs/guides/choosing-an-id-13","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"UUID v7 with a readable, domain-specific prefix."},"195":{"id":"/docs/guides/choosing-an-id-14","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Short URLs and invite codes"},"196":{"id":"/docs/guides/choosing-an-id-15","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Nanoid"},"197":{"id":"/docs/guides/choosing-an-id-16","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Compact and URL-safe."},"198":{"id":"/docs/guides/choosing-an-id-17","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Values that should resist enumeration"},"199":{"id":"/docs/guides/choosing-an-id-18","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"CUID v2"},"200":{"id":"/docs/guides/choosing-an-id-19","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Non-sequential, secure identifier."},"201":{"id":"/docs/guides/choosing-an-id-20","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"MongoDB `_id` compatibility"},"202":{"id":"/docs/guides/choosing-an-id-21","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"ObjectID"},"203":{"id":"/docs/guides/choosing-an-id-22","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Matches MongoDB's 12-byte ObjectID format."},"204":{"id":"/docs/guides/choosing-an-id-23","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Go rs/xid compatibility"},"205":{"id":"/docs/guides/choosing-an-id-24","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"XID"},"206":{"id":"/docs/guides/choosing-an-id-25","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Matches rs/xid's compact 12-byte text and binary format."},"207":{"id":"/docs/guides/choosing-an-id-26","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Native `BIGINT` storage"},"208":{"id":"/docs/guides/choosing-an-id-27","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"TSID"},"209":{"id":"/docs/guides/choosing-an-id-28","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"A sortable 64-bit integer, not a UUID-shaped string."},"210":{"id":"/docs/guides/choosing-an-id-29","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"Broad standards compatibility"},"211":{"id":"/docs/guides/choosing-an-id-30","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"UUID v4"},"212":{"id":"/docs/guides/choosing-an-id-31","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id","content":"The conventional random UUID format."},"213":{"id":"/docs/guides/choosing-an-id-32","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#a-good-default","content":"If you create records in more than one service or need an ID before inserting a row, start with UUID v7. It is a UUID-native value, sort-friendly, and uses a familiar database column type."},"214":{"id":"/docs/guides/choosing-an-id-33","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#time-ordering-is-local","content":"UUID v7, ULID, ObjectID, XID, and TSID carry time information. uniku keeps the state required for monotonic sequencing inside one JavaScript isolate; it does not coordinate clocks or sequences between processes or machines."},"215":{"id":"/docs/guides/choosing-an-id-34","page_id":"/docs/guides/choosing-an-id","tags":[],"type":"text","url":"/docs/guides/choosing-an-id#time-order-leaks-creation-time","content":"UUID v7, ULID, KSUID, ObjectID, XID, and TSID embed a creation timestamp in the identifier itself. Anyone who can read the ID can decode when the record was created, not just its order relative to other records. That is a feature for index locality and a leak if the ID is public and the creation time is sensitive, for example a document, invoice, or account that should not reveal how old it is. If the identifier is exposed outside your system and creation time must stay private, use UUID v4, CUID v2, or Nanoid instead: none of them encode a timestamp."},"216":{"id":"/docs/guides/integrations","page_id":"/docs/guides/integrations","type":"page","content":"Integrations","breadcrumbs":["Docs","Guides"],"tags":[],"url":"/docs/guides/integrations"},"217":{"id":"/docs/guides/integrations-0","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations","content":"Runnable starting points for Hono, Drizzle ORM v1, and Effect v4."},"218":{"id":"/docs/guides/integrations-1","page_id":"/docs/guides/integrations","type":"heading","tags":[],"url":"/docs/guides/integrations#hono-request-ids-with-nanoid","content":"Hono request IDs with Nanoid"},"219":{"id":"/docs/guides/integrations-2","page_id":"/docs/guides/integrations","type":"heading","tags":[],"url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"Drizzle ORM v1 with binary ULIDs"},"220":{"id":"/docs/guides/integrations-3","page_id":"/docs/guides/integrations","type":"heading","tags":[],"url":"/docs/guides/integrations#effect-v4-services-with-typeid","content":"Effect v4 services with TypeID"},"221":{"id":"/docs/guides/integrations-4","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations","content":"The examples below add Nanoid request IDs to Hono, binary ULIDs to a Drizzle schema, and prefixed TypeIDs to an Effect service. Each is self-contained and runs with the command below it."},"222":{"id":"/docs/guides/integrations-5","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#hono-request-ids-with-nanoid","content":"Hono's request ID middleware accepts a synchronous `generator`. When a request does not already carry a valid `X-Request-Id` header, this example generates a compact Nanoid, stores it in the request context, and returns it in the response header."},"223":{"id":"/docs/guides/integrations-6","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#hono-request-ids-with-nanoid","content":"Run it with `pnpm --filter @uniku/examples example:hono`."},"224":{"id":"/docs/guides/integrations-7","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"The `binaryUlid` custom type exposes a string to application code while declaring a PostgreSQL `bytea` column. Its Drizzle codec converts ULID strings to `Uint8Array` parameters and selected bytes back to canonical ULID strings."},"225":{"id":"/docs/guides/integrations-8","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"The column's `$defaultFn` generates a ULID when an insert omits `id`. Both sides of the foreign key remain 16-byte values in PostgreSQL, so the join compares their binary representation while the returned `eventId` is already a string. The example uses an in-memory PGlite database, so it needs no external PostgreSQL server."},"226":{"id":"/docs/guides/integrations-9","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"Run it with `pnpm --filter @uniku/examples example:drizzle`."},"227":{"id":"/docs/guides/integrations-10","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#drizzle-orm-v1-with-binary-ulids","content":"The example pins Drizzle ORM `1.0.0-rc.4`. Codecs are configured per PostgreSQL type, so this client treats every `bytea` column as a binary ULID. The v1 line is still a release candidate, so check its release notes before changing that version."},"228":{"id":"/docs/guides/integrations-11","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#effect-v4-services-with-typeid","content":"An Effect service keeps ID generation injectable without leaking framework types into the generated value. This service exposes a traced `next()` effect and returns TypeID strings with a stable `user_` prefix."},"229":{"id":"/docs/guides/integrations-12","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#effect-v4-services-with-typeid","content":"Run it with `pnpm --filter @uniku/examples example:effect`."},"230":{"id":"/docs/guides/integrations-13","page_id":"/docs/guides/integrations","tags":[],"type":"text","url":"/docs/guides/integrations#effect-v4-services-with-typeid","content":"This example pins Effect `4.0.0-beta.93`. Effect v4 is still prerelease software, so check its release notes before changing that version."},"231":{"id":"/docs/guides/performance","page_id":"/docs/guides/performance","type":"page","content":"Performance and bundle size","breadcrumbs":["Docs","Guides"],"tags":[],"url":"/docs/guides/performance"},"232":{"id":"/docs/guides/performance-0","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance","content":"Every uniku generator beats its dedicated npm alternative in the current CI benchmark. See the measurements and bundle cost of each import."},"233":{"id":"/docs/guides/performance-1","page_id":"/docs/guides/performance","type":"heading","tags":[],"url":"/docs/guides/performance#generation-speed","content":"Generation speed"},"234":{"id":"/docs/guides/performance-2","page_id":"/docs/guides/performance","type":"heading","tags":[],"url":"/docs/guides/performance#bundle-size","content":"Bundle size"},"235":{"id":"/docs/guides/performance-3","page_id":"/docs/guides/performance","type":"heading","tags":[],"url":"/docs/guides/performance#reproduce-these-numbers","content":"Reproduce these numbers"},"236":{"id":"/docs/guides/performance-4","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance","content":"Generation speed is a primary design constraint in uniku. In the current CI snapshot, every one of its ten strategies beats the dedicated npm implementation it targets. The smallest measured lead is 1.2× for UUID v4 and ObjectID; ULID reaches 116×."},"237":{"id":"/docs/guides/performance-5","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance","content":"The claim is deliberately scoped to generation speed against the established package for each format. Application performance still depends on where and how IDs are created."},"238":{"id":"/docs/guides/performance-6","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Each row compares uniku's generator against the npm package it targets: `uuid` for UUID v4/v7, `ulid`, `@paralleldrive/cuid2`, `@owpz/ksuid`, `bson` for ObjectID, `nexid` for XID, `tsid-ts`, `nanoid`, and `typeid-js`."},"239":{"id":"/docs/guides/performance-7","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"This snapshot comes from a four-repetition CI run on July 14, 2026. Treat the ratios as directional because shared-runner noise and dependency updates can move them. The rolling baseline tracks results across CI runs for regression detection."},"240":{"id":"/docs/guides/performance-8","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Generator"},"241":{"id":"/docs/guides/performance-9","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"uniku vs npm"},"242":{"id":"/docs/guides/performance-10","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"ULID"},"243":{"id":"/docs/guides/performance-11","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"116× faster"},"244":{"id":"/docs/guides/performance-12","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"UUID v7"},"245":{"id":"/docs/guides/performance-13","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"6.3× faster"},"246":{"id":"/docs/guides/performance-14","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"CUID2"},"247":{"id":"/docs/guides/performance-15","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"6.2× faster"},"248":{"id":"/docs/guides/performance-16","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"TypeID"},"249":{"id":"/docs/guides/performance-17","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"3.3× faster"},"250":{"id":"/docs/guides/performance-18","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"TSID"},"251":{"id":"/docs/guides/performance-19","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"2.3× faster"},"252":{"id":"/docs/guides/performance-20","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Nanoid"},"253":{"id":"/docs/guides/performance-21","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"2× faster"},"254":{"id":"/docs/guides/performance-22","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"KSUID"},"255":{"id":"/docs/guides/performance-23","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"1.6× faster"},"256":{"id":"/docs/guides/performance-24","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"XID"},"257":{"id":"/docs/guides/performance-25","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"1.4× faster"},"258":{"id":"/docs/guides/performance-26","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"Nanoid (10 chars)"},"259":{"id":"/docs/guides/performance-27","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"1.4× faster"},"260":{"id":"/docs/guides/performance-28","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"UUID v4"},"261":{"id":"/docs/guides/performance-29","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"1.2× faster"},"262":{"id":"/docs/guides/performance-30","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"ObjectID"},"263":{"id":"/docs/guides/performance-31","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"1.2× faster"},"264":{"id":"/docs/guides/performance-32","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#generation-speed","content":"The compatibility benchmark runs each implementation in a fresh process. CI balances both launch orders across four repetitions and reports the per-row median, so warmed runtime state and one noisy run do not decide the comparison."},"265":{"id":"/docs/guides/performance-33","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"Every entry point is independently importable and tree-shakeable: importing `uniku/ulid` does not pull in the ULID, TypeID, or KSUID code. Minified and gzipped sizes per entry point:"},"266":{"id":"/docs/guides/performance-34","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"Import"},"267":{"id":"/docs/guides/performance-35","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"Minified + gzipped"},"268":{"id":"/docs/guides/performance-36","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"`uniku/ulid`"},"269":{"id":"/docs/guides/performance-37","page_id":"/docs/guides/performance","tags":[],"type":"text","url":"/docs/guides/performance#bundle-size","content":"\\~1.9 KB"},"270":{"