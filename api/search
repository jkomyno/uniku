:"/docs/reference/errors#generator-list","content":"`IdGenerator` is the union type derived from `ID_GENERATORS`. Tools that enumerate or validate generator kinds, such as `@uniku/cli`'s `--type` flag, should derive from this array instead of hand-copying the union."},"574":{"id":"/docs/reference/ksuid","page_id":"/docs/reference/ksuid","type":"page","content":"KSUID","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/ksuid"},"575":{"id":"/docs/reference/ksuid-0","page_id":"/docs/reference/ksuid","tags":[],"type":"text","url":"/docs/reference/ksuid","content":"Time-ordered identifiers with a 128-bit random payload."},"576":{"id":"/docs/reference/ksuid-1","page_id":"/docs/reference/ksuid","tags":[],"type":"text","url":"/docs/reference/ksuid","content":"KSUID combines a timestamp with a large random payload. Choose it for high-volume distributed systems that need chronological order and a 27-character URL-safe string."},"577":{"id":"/docs/reference/nanoid","page_id":"/docs/reference/nanoid","type":"page","content":"Nanoid","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/nanoid"},"578":{"id":"/docs/reference/nanoid-0","page_id":"/docs/reference/nanoid","tags":[],"type":"text","url":"/docs/reference/nanoid","content":"Compact, URL-safe random strings with configurable length and alphabet."},"579":{"id":"/docs/reference/nanoid-1","page_id":"/docs/reference/nanoid","tags":[],"type":"text","url":"/docs/reference/nanoid","content":"Nanoid is the compact choice for short URLs, invite codes, and session tokens. Its default alphabet is URL-safe; pass a length or options only when the boundary needs a different shape."},"580":{"id":"/docs/reference/nanoid-2","page_id":"/docs/reference/nanoid","tags":[],"type":"text","url":"/docs/reference/nanoid","content":"`nanoid.isValid()` validates the default alphabet, not values generated with a custom alphabet."},"581":{"id":"/docs/reference/objectid","page_id":"/docs/reference/objectid","type":"page","content":"ObjectID","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/objectid"},"582":{"id":"/docs/reference/objectid-0","page_id":"/docs/reference/objectid","tags":[],"type":"text","url":"/docs/reference/objectid","content":"MongoDB-compatible 12-byte identifiers."},"583":{"id":"/docs/reference/objectid-1","page_id":"/docs/reference/objectid","tags":[],"type":"text","url":"/docs/reference/objectid","content":"ObjectID matches MongoDB's native 12-byte representation. Use it when your application stores `_id` values alongside MongoDB clients or needs to preserve that wire format."},"584":{"id":"/docs/reference/tsid","page_id":"/docs/reference/tsid","type":"page","content":"TSID","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/tsid"},"585":{"id":"/docs/reference/tsid-0","page_id":"/docs/reference/tsid","tags":[],"type":"text","url":"/docs/reference/tsid","content":"Time-sorted 64-bit identifiers for native bigint storage."},"586":{"id":"/docs/reference/tsid-1","page_id":"/docs/reference/tsid","tags":[],"type":"text","url":"/docs/reference/tsid","content":"TSID returns a `bigint`, not a string. Use it when a database `BIGINT` primary key is the natural representation and you still need time ordering without a central allocator."},"587":{"id":"/docs/reference/typeid","page_id":"/docs/reference/typeid","type":"page","content":"TypeID","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/typeid"},"588":{"id":"/docs/reference/typeid-0","page_id":"/docs/reference/typeid","tags":[],"type":"text","url":"/docs/reference/typeid","content":"UUID v7 identifiers with a readable, domain-specific prefix."},"589":{"id":"/docs/reference/typeid-1","page_id":"/docs/reference/typeid","tags":[],"type":"text","url":"/docs/reference/typeid","content":"TypeID wraps a UUID v7 suffix in a lowercase prefix such as `user_` or `order_`. It is useful when a public identifier should reveal the kind of resource it identifies."},"590":{"id":"/docs/reference/ulid","page_id":"/docs/reference/ulid","type":"page","content":"ULID","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/ulid"},"591":{"id":"/docs/reference/ulid-0","page_id":"/docs/reference/ulid","tags":[],"type":"text","url":"/docs/reference/ulid","content":"Sortable, URL-safe identifiers using Crockford Base32."},"592":{"id":"/docs/reference/ulid-1","page_id":"/docs/reference/ulid","tags":[],"type":"text","url":"/docs/reference/ulid","content":"ULIDs sort by creation time and stay shorter than a hyphenated UUID. Use them when the value will often appear in URLs, logs, or APIs."},"593":{"id":"/docs/reference/uuid-v4","page_id":"/docs/reference/uuid-v4","type":"page","content":"UUID v4","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/uuid-v4"},"594":{"id":"/docs/reference/uuid-v4-0","page_id":"/docs/reference/uuid-v4","tags":[],"type":"text","url":"/docs/reference/uuid-v4","content":"Random, standards-compatible UUIDs with 122 bits of entropy."},"595":{"id":"/docs/reference/uuid-v4-1","page_id":"/docs/reference/uuid-v4","tags":[],"type":"text","url":"/docs/reference/uuid-v4","content":"UUID v4 is the default when compatibility matters more than sort order. It fits databases and APIs that already understand UUID strings."},"596":{"id":"/docs/reference/uuid-v4-2","page_id":"/docs/reference/uuid-v4","tags":[],"type":"text","url":"/docs/reference/uuid-v4","content":"Use `toBytes()` when the destination stores UUIDs as 16-byte binary values. Use `isValid()` before accepting an unknown UUID v4 string at an application boundary."},"597":{"id":"/docs/reference/uuid-v7","page_id":"/docs/reference/uuid-v7","type":"page","content":"UUID v7","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/uuid-v7"},"598":{"id":"/docs/reference/uuid-v7-0","page_id":"/docs/reference/uuid-v7","tags":[],"type":"text","url":"/docs/reference/uuid-v7","content":"Time-ordered UUIDs for primary keys, APIs, and event streams."},"599":{"id":"/docs/reference/uuid-v7-1","page_id":"/docs/reference/uuid-v7","tags":[],"type":"text","url":"/docs/reference/uuid-v7","content":"UUID v7 keeps the UUID shape while embedding a millisecond timestamp. It is a strong default for database primary keys when you want chronological locality without creating a custom ID column."},"600":{"id":"/docs/reference/xid","page_id":"/docs/reference/xid","type":"page","content":"XID","breadcrumbs":["Docs","Reference"],"tags":[],"url":"/docs/reference/xid"},"601":{"id":"/docs/reference/xid-0","page_id":"/docs/reference/xid","tags":[],"type":"text","url":"/docs/reference/xid","content":"Compact, time-ordered identifiers compatible with rs/xid."},"602":{"id":"/docs/reference/xid-1","page_id":"/docs/reference/xid","tags":[],"type":"text","url":"/docs/reference/xid","content":"XID is a 12-byte, lowercase base32hex identifier: a seconds-precision timestamp, a 40-bit per-runtime identity, and a shared 24-bit counter. Use it when you need Go's rs/xid wire format in a synchronous JavaScript runtime."},"603":{"id":"/docs/reference/xid-2","page_id":"/docs/reference/xid","tags":[],"type":"text","url":"/docs/reference/xid","content":"The default identity is random and cached for this runtime. Supplying `machineId` or `processId` changes only that field; calls still use the shared counter unless you also supply `counter`. Supply all four fields for deterministic output."},"604":{"id":"/docs/reference/xid-3","page_id":"/docs/reference/xid","tags":[],"type":"text","url":"/docs/reference/xid","content":"Independent runtimes choose their identity randomly, so uniqueness across them remains probabilistic rather than host-anchored as in Go's `rs/xid` implementation."}},"count":604},"sorting":{"language":"english","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":314,"2":385,"3":404,"4":374,"5":572,"6":549,"7